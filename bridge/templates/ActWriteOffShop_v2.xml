<?xml version="1.0" encoding="UTF-8"?>
<!-- ЦЕХ: вскрытие тары = списание из торгового зала (регистр 2) с типом «Реализация».
     ШАБЛОН: перед запуском сверьте элементы и пространства имён со схемами ЕГАИС вашей версии УТМ.
     Метки {{...}} заполняет мост: FSRAR_ID, IDENTITY, ACT_NUMBER, DATE, ALCOCODE, NAME, CAPACITY, ALC_VOLUME, VCODE, MARK. -->
<ns:Documents Version="1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01"
  xmlns:awr="http://fsrar.ru/WEGAIS/ActWriteOffShop_v2"
  xmlns:pref="http://fsrar.ru/WEGAIS/ProductRef_v2"
  xmlns:ce="http://fsrar.ru/WEGAIS/CommonV3">
  <ns:Owner>
    <ns:FSRAR_ID>{{FSRAR_ID}}</ns:FSRAR_ID>
  </ns:Owner>
  <ns:Document>
    <ns:ActWriteOffShop_v2>
      <awr:Identity>{{IDENTITY}}</awr:Identity>
      <awr:Header>
        <awr:ActNumber>{{ACT_NUMBER}}</awr:ActNumber>
        <awr:ActDate>{{DATE}}</awr:ActDate>
        <awr:TypeWriteOff>Реализация</awr:TypeWriteOff>
        <awr:Note>Вскрытие тары</awr:Note>
      </awr:Header>
      <awr:Content>
        <awr:Position>
          <awr:Identity>1</awr:Identity>
          <awr:Quantity>1</awr:Quantity>
          <awr:Product>
            <pref:FullName>{{NAME}}</pref:FullName>
            <pref:AlcCode>{{ALCOCODE}}</pref:AlcCode>
            <pref:Capacity>{{CAPACITY}}</pref:Capacity>
            <pref:AlcVolume>{{ALC_VOLUME}}</pref:AlcVolume>
            <pref:ProductVCode>{{VCODE}}</pref:ProductVCode>
          </awr:Product>
          <awr:MarkCodeInfo>
            <ce:amc>{{MARK}}</ce:amc>
          </awr:MarkCodeInfo>
        </awr:Position>
      </awr:Content>
    </ns:ActWriteOffShop_v2>
  </ns:Document>
</ns:Documents>
