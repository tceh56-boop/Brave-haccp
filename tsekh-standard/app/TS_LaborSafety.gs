    '<h2 style="text-align:center;font-size:16px;margin:14px 0 2px">' + _tsEsc_(t.name) + '</h2><div style="text-align:center;margin-bottom:12px">№ ' + _tsEsc_(no) + ' от ' + Utilities.formatDate(new Date(), _mcTz_(), 'dd.MM.yyyy') + '</div>' +
    '<table style="width:100%;border-collapse:collapse">' + rows + '</table>' +
    '<p style="font-size:11px;color:#555;margin-top:10px">Основание: ' + _tsEsc_(t.basis) + '. Составил: ' + _tsEsc_(who) + '.</p>' +
    '<table style="width:100%;margin-top:28px;font-size:12px"><tr><td>Председатель / руководитель ____________ /____________/</td><td>Члены комиссии ____________ /____________/</td></tr></table>' +
    (typeof _mcOrgFooterHtml_ === 'function' ? _mcOrgFooterHtml_(no) : '') + '</div>';
}
