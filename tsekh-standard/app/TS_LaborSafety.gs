function _tsOt_(general, before, during, emergency, after) {
  return '1. ОБЩИЕ ТРЕБОВАНИЯ ОХРАНЫ ТРУДА\n' + general + '\n\n2. ТРЕБОВАНИЯ ОХРАНЫ ТРУДА ПЕРЕД НАЧАЛОМ РАБОТЫ\n' + before +
    '\n\n3. ТРЕБОВАНИЯ ОХРАНЫ ТРУДА ВО ВРЕМЯ РАБОТЫ\n' + during + '\n\n4. ТРЕБОВАНИЯ ОХРАНЫ ТРУДА В АВАРИЙНЫХ СИТУАЦИЯХ\n' + emergency +
    '\n\n5. ТРЕБОВАНИЯ ОХРАНЫ ТРУДА ПО ОКОНЧАНИИ РАБОТЫ\n' + after;
}
var TS_OT_COMMON_ = '1.1. К работе допускаются лица, прошедшие обязательный предварительный медицинский осмотр, имеющие личную медицинскую книжку, прошедшие вводный инструктаж, первичный инструктаж на рабочем месте, стажировку и обучение по охране труда.\n' +
  '1.2. Работник соблюдает правила внутреннего трудового распорядка, режим труда и отдыха, требования настоящей инструкции, правил личной гигиены и санитарных правил.\n' +
  '1.3. Возможные опасности: движущиеся части оборудования, острые кромки инструмента, горячие поверхности, пар и горячие жидкости, электрический ток, скользкий пол, перемещение тяжестей, моющие и дезинфицирующие средства.\n' +
  '1.4. Работник использует выданные СИЗ и спецодежду, сообщает непосредственному руководителю о каждом несчастном случае, микротравме, неисправности оборудования и ухудшении здоровья.\n' +
  '1.5. Курение и приём пищи — только в отведённых местах. Запрещается работать в состоянии алкогольного, наркотического или токсического опьянения.';
var TS_OT_EMERG_ = '4.1. При неисправности оборудования, искрении, запахе гари, появлении напряжения на корпусе — прекратить работу, отключить оборудование от сети, сообщить руководителю.\n' +
  '4.2. При пожаре — сообщить по телефону 101 (112), руководителю, по возможности приступить к тушению первичными средствами, при угрозе жизни — эвакуироваться.\n' +
  '4.3. При травме — оказать первую помощь, вызвать скорую помощь (103 / 112), сообщить руководителю, сохранить обстановку на месте происшествия, если это не угрожает жизни и здоровью людей.';
var TS_OT_AFTER_ = '5.1. Отключить оборудование от сети, дождаться остывания горячих поверхностей.\n5.2. Очистить, вымыть и продезинфицировать оборудование и инвентарь по санитарным инструкциям.\n5.3. Убрать рабочее место, снять спецодежду и СИЗ, вымыть руки.\n5.4. Сообщить руководителю о замеченных неисправностях и нарушениях.';
