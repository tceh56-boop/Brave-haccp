# ЦЕХ Стандарт — настройки сервера. Скопируйте в .env и заполните на сервере (файл .env не попадает в git).

# Домен, на который указывает A-запись с публичным IP виртуальной машины
DOMAIN=tsekh.example.ru
APP_URL=https://tsekh.example.ru
# Почта для уведомлений Let's Encrypt (необязательно)
ACME_EMAIL=

# Часовой пояс по умолчанию для новых предприятий
TZ_DEFAULT=Asia/Yekaterinburg

# Процессы для запросов (плюс отдельный планировщик). 2 ядра / 4 ГБ — 2; 4 ядра / 8 ГБ — 4
WORKERS=2
MAX_BODY_MB=50

# Почта (вместо Gmail): SMTP Яндекс 360 с паролем приложения
# smtps://robot%40tsekh.example.ru:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.yandex.ru:465
SMTP_URL=
MAIL_FROM="ЦЕХ Стандарт <robot@tsekh.example.ru>"
MAIL_DAILY_LIMIT=500

# Резервные копии в Yandex Object Storage (deploy/backup.sh). Ключи — статический ключ сервисного аккаунта
S3_BUCKET=
S3_PREFIX=tsekh-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_KEEP_DAYS=30

# Ключи Yandex Vision и YandexGPT задаются не здесь, а в свойствах предприятия на сервере:
#   docker compose exec app node tools/tenant.js props <код> YANDEX_API_KEY=… YANDEX_FOLDER_ID=…
