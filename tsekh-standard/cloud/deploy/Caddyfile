{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip
	# фото и сканы накладных; должно совпадать с MAX_BODY_MB в .env
	request_body {
		max_size 60MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:8080 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
