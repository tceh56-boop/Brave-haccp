# Скопируйте в .env и заполните — для сервера с HTTPS (docker compose --profile https up -d --build).
# Нет своего домена — подойдёт <IP-сервера>.sslip.io, например 203.0.113.10.sslip.io
DOMAIN=203.0.113.10.sslip.io
APP_URL=https://203.0.113.10.sslip.io
APP_BIND=127.0.0.1
# придумайте свои пароли
DB_PASSWORD=смените-пароль-базы
MAIL_UI_AUTH=admin:смените-пароль-почты
# 1 — создать демо-организацию «Кафе «Демо»» (пароль у всех известен: только для показа); 0 — без неё
DEMO=1
# почта: пусто — ящик стенда Mailpit (https://<домен>/mail/); Яндекс 360 — smtps://ящик%40домен.ru:пароль_приложения@smtp.yandex.ru:465
SMTP_URL=
MAIL_FROM=
# резервные копии в Yandex Object Storage (deploy/backup.sh); пусто — копии только на сервере
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# распознавание документов (ТОРГ-12, УПД, QR чека, банкетный бланк) — Yandex Vision + YandexGPT; платно, по страницам.
# Сервисный аккаунт с ролями ai.vision.user и ai.languageModels.user → API-ключ. Пусто — распознавание выключено.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest
RECOGNITION_LLM_DISABLED=
# ключ AI — необязательно; вызовы платные; для пилота в РФ не включать (152-ФЗ, трансграничная передача)
ANTHROPIC_API_KEY=
