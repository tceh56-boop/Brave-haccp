/* Чек-листы ППК: формируются при сборке программы из положений нормативной базы и данных объекта.
   Строка: [чек-лист, контрольный пункт]; основание — ссылка на положение (сверка как у положения) или на пункт документа. */
var Checklists2 = {
  LISTS: [
    ['J11', 'Чек-лист открытия смены', 'ежедневно до начала работы'],
    ['J12', 'Чек-лист закрытия смены', 'ежедневно по окончании работы'],
    ['CL-ПР', 'Чек-лист приёмки сырья и продукции', 'каждая поставка'],
