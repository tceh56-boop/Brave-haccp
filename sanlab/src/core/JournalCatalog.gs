    N('J12', S26, 'п. 21', 'Проведена влажная уборка производственных помещений с моющими и дезинфицирующими средствами (J46)');
    N('J12', SP84, 'п. 13', 'Уборочный инвентарь промыт, ополоснут, просушен и убран в отведённое место; инвентарь для туалетов — отдельно');
    N('J12', SP84, 'п. 10, 11', 'Отходы собраны в контейнеры с крышками и вынесены, контейнеры не переполнены');
    if (has('children')) N('J12', S26, 'п. 59, пп. 10', 'Суточные пробы от каждой партии отобраны и убраны на хранение 48 часов при +2…+6 °C');
    M('J12', 'Журналы за смену заполнены, отклонения переданы ответственному и внесены в J34');

    /* Приёмка */
    N('CL-ПР', S26, 'п. 5', 'Продукция принимается только при наличии маркировки, товаросопроводительных документов и сведений о подтверждении соответствия');
    M('CL-ПР', 'Условия перевозки соблюдены (температура в кузове, чистота транспорта, раздельная перевозка сырья и готовой продукции)', S26 + ', п. 5, 28');
    M('CL-ПР', 'Маркировка читаема: наименование, состав, количество, дата изготовления, срок годности, условия хранения, изготовитель, знак ЕАС', 'ТР ТС 022/2011, ст. 4, ч. 4.1');
    M('CL-ПР', 'Срок годности не истёк, остаточный срок достаточен для использования');
    M('CL-ПР', 'Температура скоропортящейся и замороженной продукции измерена и соответствует маркировке');
    M('CL-ПР', 'Упаковка целая, без следов вскрытия, порчи и загрязнения; органолептические признаки в норме');
    M('CL-ПР', 'Результат приёмки внесён в журнал приёмки и входного контроля (J39)', S26 + ', прил. 5');

    /* Еженедельный */
    M('CL-НЕД', 'Полы, стены, потолки, двери, окна чистые и без повреждений; покрытия устойчивы к влажной уборке', SP84 + ', п. 9');
    M('CL-НЕД', 'Светильники исправны и чистые; вентиляция работает, доступные решётки чистые', S26 + ', п. 15–18');
    if (has('sous_vide') || has('vacuum')) M('CL-НЕД', 'Вакуумный упаковщик и оборудование sous-vide очищены и продезинфицированы');
    if (has('frying') || has('hot_shop')) M('CL-НЕД', 'Жарочное и тепловое оборудование очищено от нагара и жира');
    N('CL-НЕД', S26, 'п. 22', 'Уборочный инвентарь промаркирован по назначению помещений и хранится в отведённых местах');
    M('CL-НЕД', 'Моющие и дезинфицирующие средства хранятся отдельно от пищевой продукции', S26 + ', п. 46');
    N('CL-НЕД', SP84, 'п. 14', 'Нет насекомых, грызунов и следов их жизнедеятельности; при обнаружении вызвана специализированная организация (J14)');
    M('CL-НЕД', 'Журналы за неделю заполнены полностью, отклонения разобраны');

    /* J49 Санитарный день — по образцу заказчика */
    M('J49', 'Санитарная обработка проводится сверху вниз: сначала поверхности выше рабочих зон, в конце — полы');
    M('J49', 'Оборудование по возможности отодвинуто от стен; обработаны поверхности вокруг и под ним');
    M('J49', 'Удалены пыль, паутина, посторонние предметы во всех производственных цехах, моечных, складских и подсобных помещениях (в том числе в труднодоступных зонах)');
    M('J49', 'Тщательно вымыты оборудование, полки, стеллажи, стены, окна, двери, вентиляционные решётки и купола, элементы отопления, светильники, сантехника, ёмкости для отходов');
    M('J49', 'Решётки сливных трапов очищены от налёта');
    M('J49', 'Полы и плинтусы тщательно промыты и очищены от налёта');
    M('J49', 'Потолки и потолочные конструкции (карнизы) протёрты');
    if (has('cold_shop') || has('confectionery')) M('J49', 'Корпуса бактерицидных ламп протёрты от пыли', S26 + ', п. 17');
    M('J49', 'Кухонная посуда почищена; транспортировочные тележки вымыты');
    M('J49', 'Генеральная уборка отмечена в графике и учёте генеральных уборок (J48)');

    /* Производственный контроль — по разделам собранной программы */
    var cell = function (r, k) { return V.str((r.c || [])[k]); };
    var fromRow = function (r, text) { var x = JSON.parse(JSON.stringify(r)); x.c = [L['CL-ПК'], JournalCat.unJ(text)]; delete x.manual; delete x.src; if (r.manual) { x.manual = true; x.src = r.src || 'input'; } return x; };
    var sec = function (k) { return filterBy(secs || [], function (s) { return s.key === k; })[0] || { rows: [] }; };
    sec('journals').rows.forEach(function (r) { var old = cell(r, 0) && /^J\d/.test(cell(r, 0)), t = old ? cell(r, 1) : cell(r, 0), f = old ? cell(r, 2) : cell(r, 1);
      if (t) out.push(fromRow(r, 'Ведётся «' + t + '» (' + (f || 'по графику') + '), записи полные, отклонения отработаны')); });
    sec('lab').rows.forEach(function (r) { out.push(fromRow(r, 'Лабораторный контроль: ' + cell(r, 0) + ' — ' + (cell(r, 2) || 'по программе') + '; протоколы аккредитованной лаборатории за период в наличии')); });
    sec('prof').rows.forEach(function (r) { out.push(fromRow(r, cell(r, 0) + ': сроки у всех работников не просрочены, сведения внесены в J45')); });
    M('CL-ПК', 'Средства измерений (термометры, гигрометры, весы) проверены по графику (J19, J20)');
    M('CL-ПК', 'Дезинсекция и дератизация выполнены по договору, акты в наличии (J14)');
    M('CL-ПК', 'Несоответствия за месяц закрыты, корректирующие действия проверены (J34)');

    /* Аудит ХАССП */
    ['ППК и план ХАССП утверждены, соответствуют фактическим процессам и ассортименту', 'Для ККТ определены критические пределы, мониторинг и корректирующие действия; записи ККТ ведутся по партиям',
      'Приёмка и прослеживаемость документированы', 'Температурные журналы заполнены без пропусков', 'Маркировка и сроки годности контролируются',
      'Санитарная обработка и концентрации дезрастворов документируются', 'Персонал допущен к работе и обучен (J16, J17, J53)', 'Лабораторная программа выполняется',
      'Верификационные проверки проведены (J33), несоответствия закрыты с проверкой эффективности', 'Изменения процессов и нормативов отражены в ППК и плане ХАССП'].forEach(function (t) { M('CL-ХАССП', t, 'ТР ТС 021/2011, ст. 10–11'); });
    if (has('sous_vide')) M('CL-ХАССП', 'Sous-vide выполняется по валидированным картам продукта (J22a)');
    return out;
  }
};
