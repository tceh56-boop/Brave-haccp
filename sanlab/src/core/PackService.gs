        { t: 'p', text: 'Отметка: ✓ выполнено / ✗ нарушение / НП — не применимо. Каждое нарушение — корректирующее действие и запись в J34.', small: true },
        tbl(['№', 'Контрольный пункт', 'Основание', '✓/✗/НП', 'Комментарий / действие', 'Подпись'], gmap[k].map(function (r, i) { return [String(i + 1), r.c[1], r.ref || '', '', '', '']; }), { widths: [1, 11, 4, 2, 5, 2] })]);
      var id = title.split(' ')[0]; jIdx[id] = D.length;
      add(title, b);
    });

    /* 30 График работы */
    var m = String(mode).match(/(\d{1,2})[:.](\d{2})\s*[–-]\s*(\d{1,2})[:.](\d{2})/), days = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'], sched;
    if (m) {
      var o = Number(m[1]), c = Number(m[3]), hh = function (h) { return pad2(Math.max(0, h)) + ':' + m[2]; };
      sched = days.map(function (d) { return [d, hh(o - 2) + '–' + hh(o), hh(o) + '–' + hh(c - 1), hh(o) + '–' + pad2(c) + ':' + m[4], hh(c - 1) + '–' + pad2(c) + ':' + m[4]]; });
    } else sched = days.map(function (d) { return [d, '', '', mode, '']; });
    add('График работы, заготовки и продажи', H('График работы, заготовки и продажи').concat([{ t: 'p', text: 'Режим реализации: ' + (mode || '__________') + '. Время заготовки ниже — проектный шаблон; перед утверждением привести в соответствие с фактическим режимом работников.' },
      { t: 'table', head: ['День', 'Заготовка*', 'Производство', 'Продажа', 'Закрытие'], rows: sched, widths: [1, 2, 2, 2, 2] }, { t: 'p', text: '* Если фактической заготовки до открытия нет, график заменить на фактический. Заготовка не должна приводить к накоплению продукции сверх утверждённых сроков.', small: true }]));

    /* 31–35 Памятка, ознакомление, реестры, график санобработки */
    add('Памятка по маркировке и реализации', H('Памятка по маркировке и реализации').concat([{ t: 'table', head: ['Элемент', 'Что проверить'], rows: [['Наименование', 'точное наименование продукции'], ['Состав', 'по рецептуре'], ['Аллергены', 'указание по применимым требованиям'], ['Масса', 'масса нетто/количество'], ['Дата', 'дата изготовления/упаковки — по применимости'], ['Срок', 'только по утверждённой ТД'], ['Условия', 'температура/условия по ТД'], ['Производитель', sh + ' и адрес — по применимости'], ['Партия', 'идентификатор прослеживаемости'], ['Документы', 'ТУ/ТТК/декларация — по применимости']], widths: [1, 4] },
      { t: 'p', text: 'Не устанавливать сроки годности по аналогии с чужой продукцией. Для каждой позиции срок и условия должны иметь документальное обоснование.' }]));
    var fam = staff.map(function (s, i) { return [String(i + 1), s[0], 'ППК, план ХАССП, инструкции', '', '', '']; });
    for (var k = fam.length + 1; k <= 15; k++) fam.push([String(k), '', '', '', '', '']);
    add('Лист ознакомления с документами', H('Лист ознакомления с документами').concat([{ t: 'table', head: ['№', 'ФИО', 'Документ', 'Дата', 'Подпись работника', 'Подпись ответственного'], rows: fam, widths: [1, 5, 5, 2, 3, 3], rowHeight: 340 }]));
    add('Реестр поставщиков', H('Реестр поставщиков').concat([{ t: 'table', head: ['№', 'Поставщик', 'ИНН/реквизиты', 'Сырьё', 'Документы', 'Условия доставки', 'Допуск', 'Дата проверки'], rows: Pack.empty(8, 15), widths: [1, 4, 3, 3, 3, 3, 2, 2], rowHeight: 340 }]));
    var eqRows = equip.map(function (e, i) { return [String(i + 1), e[0], '', '', '', '', '', '']; });
    for (var q = eqRows.length + 1; q <= 15; q++) eqRows.push([String(q), '', '', '', '', '', '', '']);
    add('Реестр оборудования и техобслуживание', H('Реестр оборудования и техобслуживание').concat([{ t: 'table', head: ['№', 'Оборудование', 'Марка/модель', 'Инв.№', 'Критичный параметр', 'Обслуживание', 'Поверка/калибровка', 'Следующая дата'], rows: eqRows, widths: [1, 4, 3, 2, 3, 3, 3, 2], rowHeight: 340 }]));
    var san = [['Рабочие поверхности', 'мойка+дез', '✓', 'глубокая уборка', '', '', ''], ['Полы', 'мойка', '✓', 'труднодоступные зоны', '', '', ''], ['Холодильники', 'контроль', '✓', 'детальная уборка', '', '', '']];
    if (sv || vac) san.push([(sv ? 'Sous-vide/' : '') + 'вакууматор', 'санобработка', '✓', 'детальная', '', '', '']);
    if (fr || Pack.has(P, 'hot_shop')) san.push(['Жарочное/тепловое оборудование', 'очистка', '✓', 'детальная', '', '', '']);
    san.push(['Вентиляция', 'визуально', '✓', 'очистка доступных поверхностей', 'сервис', '', ''], ['Светильники', 'визуально', 'по загрязнению', 'очистка', 'по графику', '', ''], ['Уборочный инвентарь', 'обработка', '✓', 'проверка состояния', 'по износу', '', '']);
    add('График санитарных мероприятий', H('График санитарных мероприятий').concat([{ t: 'table', head: ['Объект', 'Ежесменно', 'Ежедневно', 'Еженедельно', 'По графику', 'Средство', 'Ответственный'], rows: san, widths: [4, 2, 2, 3, 2, 3, 3] }]));

    /* 36 Справка по нормативной базе */
    var used = (content.norms || []).map(function (id) { return Repo.get('NormDocs', id); }).filter(Boolean);
    Repo.where('NormDocs', function (d) { return Norms.inForce(d, ctx.now) && csvList(d.scopes).indexOf('TU') >= 0 && specs.length; }).forEach(function (d) { if (used.indexOf(d) < 0 && !used.some(function (u) { return u.norm_id === d.norm_id; })) used.push(d); });
    used = sortBy(used.filter(function (d) { return Norms.inForce(d, ctx.now); }), 'code');
    var changed = Repo.where('NormDocs', function (d) { return d.valid_until && isBefore(d.valid_until, ctx.now) && isBefore(isoAddDays(ctx.now, -400), d.valid_until); });
    var fresh = Repo.where('NormDocs', function (d) { return d.valid_from && Norms.inForce(d, ctx.now) && isBefore(isoAddDays(ctx.now, -400), d.valid_from); });
    var ref = H('Справка по нормативной базе на ' + fmtD(ctx.now));
    if (fresh.length || changed.length) ref.push({ t: 'p', text: (fresh.length ? 'Недавно вступили в силу: ' + fresh.map(function (d) { return d.code + ' (с ' + fmtD(d.valid_from) + ')'; }).join('; ') + '. ' : '') + (changed.length ? 'Утратили силу: ' + changed.map(function (d) { return d.code + ' (с ' + fmtD(d.valid_until) + ')'; }).join('; ') + '.' : '') });
    ref.push({ t: 'h', text: 'Основные документы' }, { t: 'table', head: ['Документ', 'Наименование', 'Срок действия', 'Сверка с официальным текстом'], rows: used.map(function (d) { return [d.code, d.title, d.valid_until ? 'до ' + fmtD(d.valid_until) : (d.valid_from ? 'с ' + fmtD(d.valid_from) : 'без ограничения'), V.bool(d.verified) ? 'сверено' + (d.verified_at ? ' ' + fmtD(d.verified_at) : '') : 'требует сверки']; }), widths: [3, 8, 2, 3] },
      { t: 'p', text: 'Перед фактическим применением сверить актуальные редакции официального опубликования и конкретную применимость требований к ассортименту и способу реализации.' });
    add('Справка по нормативной базе на ' + fmtD(ctx.now).replace(/\./g, '_'), ref);

    /* 00 Паспорт комплекта */
    var final = ['внести фактический ассортимент и номера ТТК/ТУ/деклараций;'];
    if (th) final.push('внести фактические критические пределы по каждой ККТ' + (sv ? ', особенно sous-vide' : '') + ';');
    final.push('внести фактические моющие/дезинфицирующие средства и режимы производителя;', 'внести фактический состав персонала и ответственных;', 'проверить 2D-план по месту и исключить встречные потоки;', 'заключить/актуализировать лабораторный договор и выполнить программу;', 'проверить поверку/калибровку термометров;', 'утвердить приказы и ознакомить работников.');
    if (Number(rec.unverified_count)) final.push('сверить с официальным текстом положения нормативной базы, отмеченные в системе как «требует сверки» (' + rec.unverified_count + ').');
    /* Реестр журналов J01–J53: что ведётся на объекте и где, что не ведётся и почему */
    var regRows = JOURNALS.concat(JOURNAL_EXTRA).map(function (j) {
      var st = jIdx[j.id] !== undefined ? 'ведётся — документ № ' + pad2(jIdx[j.id]) : (j.pack === 'cl' ? 'чек-лист не сформирован' : JournalCat.status(j, flagsArr).note);
      if (j.id === 'J22a' && jIdx[j.id] === undefined) return null;
      var c = jrow[j.id] || [];
      return [j.id, j.title, j.what, j.basis, c[2] || j.freq, c[3] || j.resp, j.fill, j.overlap || '—', st];
    }).filter(Boolean);
    groups.forEach(function (k) { var id = k.split(' ')[0]; if (!JournalCat.get(id)) regRows.push([id, k.split(' — ')[0].slice(id.length + 1), 'Контрольные пункты по ППК', 'ППК, раздел «Чек-листы»', k.split(' — ').slice(1).join(' — '), 'по ППК', 'Человек', '—', 'ведётся — документ № ' + pad2(jIdx[id])]); });
    var inUse = regRows.filter(function (r) { return /^ведётся/.test(r[8]); }).length;
    D[regIdx] = { title: 'Реестр журналов', blocks: H('Реестр журналов санитарного контроля и ХАССП').concat([
      { t: 'p', text: 'Реестр J01–J53 по форме предприятия. На объекте ведётся ' + inUse + ' журналов и чек-листов; журналы с похожим назначением ведутся в одной форме (колонка «Пересекается с»), журналы для отсутствующих процессов не ведутся.' },
      { t: 'table', head: ['ID', 'Журнал / чек-лист', 'Что фиксирует', 'Основание', 'Периодичность', 'Ответственный', 'Тип заполнения', 'Пересекается с', 'Статус на объекте'], rows: regRows, widths: [1, 5, 4, 4, 3, 3, 2, 2, 4], size: 13 },
      { t: 'p', text: 'Поля, требующие фактического измерения или подтверждения человека, заполняются только по факту. Состав полей и нормативные пределы утверждает ответственный за ХАССП.', small: true }]) };
    var names = D.slice(1).map(function (d, i) { return Pack.fileName(i + 1, d.title); });
    D[0] = { title: 'Паспорт комплекта и порядок применения', blocks: H('Паспорт комплекта ППК + ХАССП').concat([
      { t: 'p', text: 'Комплект подготовлен для предприятия ' + sh + (P.area ? ', ' + P.area + ' м²' : '') + ', ' + (P.activity || OBJECT_TYPES[P.object_type] || '').toLowerCase() + (procTxt ? ', процессы ' + procTxt : '') + '.' },
      { t: 'h', text: 'Состав' }, { t: 'p', text: names.join('\n') },
      { t: 'h', text: 'Обязательная финальная адаптация' }, { t: 'p', text: final.join('\n') },
      { t: 'p', text: 'Сформировано системой ' + Settings.get('COMPANY_NAME') + ' по программе ' + rec.program_id + ' (версия ' + rec.version + ', ' + (DOC_ST_LABEL[rec.status] || rec.status) + ').', small: true }]) };
    return D;
  },
  fileName: function (n, title) { return pad2(n) + '_' + String(title).replace(/[\\\/:*?"<>|«»]/g, '').replace(/[,]/g, '').replace(/\s+/g, '_') + '.docx'; },

  /* Сформировать ZIP, сохранить на Диске и в «Документах» */
  build: function (ctx, p) {
    var rec = Repo.must('Programs', p.program_id, 'Программа');
    var client = Repo.get('Clients', rec.client_id) || {};
    var docs = Pack.docs(ctx, rec);
    var sh = Pack.short(client.legal_name), footer = 'ППК/ХАССП • ' + sh + ' • ' + fmtD(rec.approved_at || ctx.now);
    var entries = docs.map(function (d, i) { return { name: Pack.fileName(i, d.title), data: Docx.build(d.blocks, { footer: footer, title: d.title, created: ctx.now }) }; });
    var zip = Zip.build(entries, ctx.now);
    var fileName = 'Комплект_ППК_' + sh.replace(/[\\\/:*?"<>|«»'„“”]/g, '').replace(/[\s.,]+/g, '_').replace(/^_+|_+$/g, '') + '_' + fmtD(ctx.now).replace(/\./g, '-') + '.zip';
    var folder = Integr.ensureFolder(['01_CLIENTS', rec.client_id || 'NO_CLIENT', 'PPC']);
    var saved = Integr.saveFile(folder, fileName, 'application/zip', Bytes.base64(zip));
    var prev = Repo.where('Documents', function (d) { return d.entity_type === 'Programs' && d.entity_id === rec.program_id && d.document_type === 'PPC_PACK' && V.bool(d.is_actual); });
    prev.forEach(function (d) { Repo.update(ctx, 'Documents', d.document_id, { is_actual: false, invalid_reason: 'Сформирован новый комплект' }, { noAudit: true }); });
    var doc = Repo.create(ctx, 'Documents', {
      entity_type: 'Programs', entity_id: rec.program_id, document_type: 'PPC_PACK', document_no: rec.program_id + '/v' + rec.version, title: 'Комплект ППК + ХАССП (' + docs.length + ' документов), ' + rec.program_id + ' v' + rec.version,
      file_name: fileName, mime_type: 'application/zip', size_bytes: saved.size || zip.length, drive_file_id: saved.fileId, version: Number(rec.version),
      approval_status: rec.status === 'APPROVED' ? 'APPROVED' : 'DRAFT', is_actual: true, prev_document_id: prev.length ? prev[prev.length - 1].document_id : ''
    }, { action: 'PPC_PACK' });
    return { document_id: doc.document_id, file_name: fileName, documents: entries.map(function (e) { return e.name; }), size: zip.length };
  }
};
var DOC_ST_LABEL = { DRAFT: 'проект', APPROVED: 'утверждена', ARCHIVED: 'архив' };
