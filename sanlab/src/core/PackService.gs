/**
 * San.Lab — PackService.gs
 * Комплект документов ППК + ХАССП одним ZIP-архивом (по образцу комплекта заказчика, 37 документов).
 * Состав зависит от процессов объекта: документы про sous-vide, жарку и т. п. включаются только при наличии процесса.
 * Источники: данные объекта (профиль программы), разделы программы (как они отредактированы), нормативная база, ТУ клиента.
 */

var Pack = {
  ROWS: 20,
  short: function (name) {
    var m = String(name || '').match(/^ИП\s+(\S+)\s+(\S)\S*\s+(\S)\S*/);
    return m ? 'ИП ' + m[1] + ' ' + m[2] + '.' + m[3] + '.' : String(name || '');
  },
  has: function (P, f) { return csvList(P.flags).indexOf(f) >= 0; },
  thermal: function (P) { return Pack.has(P, 'sous_vide') || Pack.has(P, 'frying') || Pack.has(P, 'hot_shop'); },
  chain: function (P) {
    var t = [];
    if (Pack.has(P, 'sous_vide')) t.push('sous-vide');
    if (Pack.has(P, 'frying')) t.push('жарка/томление');
    if (!t.length && Pack.has(P, 'hot_shop')) t.push('термообработка');
    var s = ['приём сырья', 'идентификация/маркировка', 'хранение', 'подготовка'];
    if (Pack.has(P, 'vacuum')) s.push('фасование/вакуумирование');
    if (t.length) s.push(t.join(' и/или '));
    if (Pack.has(P, 'cooling')) s.push('охлаждение (если предусмотрено технологией)');
    s.push('хранение', Pack.has(P, 'buffet') || Pack.has(P, 'production') ? 'реализация' : 'реализация/раздача');
    return s.join(' → ');
  },
  sections: function (content) { return indexBy(content.sections || [], 'key'); },
  rows: function (sec, n) { return ((sec && sec.rows) || []).map(function (r) { return r.c.slice(0, n || r.c.length); }); },
  empty: function (cols, n) { var out = []; for (var i = 1; i <= (n || Pack.ROWS); i++) { var r = [String(i)]; for (var j = 1; j < cols; j++) r.push(''); out.push(r); } return out; },
  lines: function (s, n) { return V.str(s).split('\n').filter(function (l) { return V.str(l); }).map(function (l) { var a = l.split(';').map(V.str); while (a.length < n) a.push(''); return a.slice(0, n); }); },

  /* Сборка всех документов: [{ title, blocks }] в порядке комплекта */
  docs: function (ctx, rec) {
    var P = safeJson(rec.profile_json, {}), content = DocContent.load(rec), S = Pack.sections(content);
    var client = Repo.get('Clients', rec.client_id) || {}, site = Repo.get('Sites', rec.site_id) || {};
    var full = client.legal_name || '', sh = Pack.short(full), date = fmtD(rec.approved_at || ctx.now), year = String(new Date(rec.approved_at || ctx.now).getFullYear());
    var addr = site.address || '', mode = P.work_mode || '';
    var resp = Pack.lines(P.responsible, 3), staff = Pack.lines(P.staff, 2);
    var boss = P.head_name || full;
    var H = function (title) { return [{ t: 'title', text: title }, { t: 'sub', text: sh + ' • редакция на ' + date }, { t: 'kv', rows: [['Предприятие', full], ['Адрес / режим', addr + (mode ? '; ' + mode : '')]] }]; };
    var period = { t: 'p', text: 'Период: «___» __________ ' + year + ' г. — «___» __________ ' + year + ' г.  Ответственный: __________________.' };
    var J = function (title, cols, note) { var b = H(title).concat([period]); if (note) b.push({ t: 'p', text: note, small: true }); b.push({ t: 'table', head: ['№'].concat(cols), rows: Pack.empty(cols.length + 1), widths: [1].concat(cols.map(function () { return 3; })), rowHeight: 340 }); return b; };
    var C = function (title, items) { return H(title).concat([{ t: 'p', text: 'Отметка: ✓ выполнено / ✗ нарушение / НП — не применимо. Все нарушения сопровождаются корректирующим действием.' }, { t: 'table', head: ['№', 'Контрольный пункт', '✓/✗/НП', 'Комментарий', 'Подпись'], rows: items.map(function (t, i) { return [String(i + 1), t, '', '', '']; }), widths: [1, 12, 2, 6, 3], rowHeight: 340 }]); };
    var approve = { t: 'p', text: 'УТВЕРЖДАЮ\n' + sh + ' __________________\n«___» __________ ' + year + ' г.' };
    var sv = Pack.has(P, 'sous_vide'), fr = Pack.has(P, 'frying'), vac = Pack.has(P, 'vacuum'), cool = Pack.has(P, 'cooling'), th = Pack.thermal(P);
    var procTxt = [sv ? 'sous-vide' : '', fr ? 'жарка/томление' : '', !sv && !fr && Pack.has(P, 'hot_shop') ? 'термообработка' : ''].filter(String).join(', ');
    var D = [];
    var add = function (title, blocks) { D.push({ title: title, blocks: blocks }); };

    /* 00 — заполняется в конце, когда известен состав */
    D.push(null);

    /* 01 ППК */
    var objLines = [full, client.inn ? 'ИНН ' + client.inn : '', P.ogrn ? 'ОГРН/ОГРНИП ' + P.ogrn : '', 'Адрес предприятия: ' + addr, client.legal_address ? 'Юридический адрес: ' + client.legal_address : '',
      P.area ? 'Площадь: ' + P.area + ' м²' : '', P.utilities ? 'Инженерное обеспечение: ' + P.utilities : '', P.water_source ? 'Водоснабжение: ' + P.water_source : '',
      P.ventilation_desc ? 'Вентиляция и освещение: ' + P.ventilation_desc : '', 'Деятельность: ' + (P.activity || OBJECT_TYPES[P.object_type] || ''), P.tu_declarations ? 'ТУ и декларации: ' + P.tu_declarations : '', mode ? 'Режим работы: ' + mode : ''].filter(String).join('\n');
    var control = [['Приём сырья', 'каждая партия', 'маркировка, срок, температура, упаковка, документы', 'J39'], ['Холодильники/морозильники', 'каждая смена', 'температура', 'J42, J43']];
    if (th) control.push(['ККТ термообработки', 'каждая партия', 'температура/время по ТТК', 'J22']);
    if (sv) control.push(['Sous-vide', 'каждый цикл', 'режим по валидированной карте продукта', 'J22a']);
    control.push(['Дезрастворы', 'каждая порция', 'концентрация/экспозиция', 'J15'], ['Уборка', 'ежедневно/по графику', 'санитарное состояние', 'J46, J48'], ['Персонал', 'каждая смена', 'допуск/гигиена', 'J44'],
      ['Маркировка', 'каждая партия', 'состав, срок, условия, партия', 'J05'], ['Лабораторный контроль', 'по программе', 'вода, смывы, продукция и др. по риску', 'Протоколы'], ['Условия труда', 'по программе', 'факторы рабочей среды по применимости', 'Протоколы']);
    Pack.rows(S.measures, 3).forEach(function (r) { control.push([r[0], r[1], 'выполнение мероприятия', r[2] || 'запись в журнале']); });
    var ppc = H('Программа производственного контроля (ППК)').concat([
      { t: 'h', text: '1. Общие положения' }, { t: 'p', text: 'ППК устанавливает порядок контроля санитарного состояния, безопасности пищевой продукции, технологических режимов, условий труда и документирования результатов. ППК интегрирована с системой ХАССП.' },
      { t: 'h', text: '2. Объект и процессы' }, { t: 'p', text: objLines }, { t: 'p', text: 'Процессы: ' + Pack.chain(P) + '. Потоки сырья, готовой продукции, отходов и уборочного инвентаря организуются с исключением перекрёстного загрязнения.' },
      { t: 'h', text: '3. Контроль' }, { t: 'table', head: ['Объект', 'Периодичность', 'Контроль', 'Запись'], rows: control, widths: [4, 3, 5, 3] },
      { t: 'h', text: '4. Лабораторный и инструментальный контроль' }, { t: 'table', head: ['Объект / точка отбора', 'Показатели', 'Периодичность', 'Объём'], rows: Pack.rows(S.lab, 4), widths: [5, 5, 3, 3] },
      { t: 'p', text: 'Подробно — документ «Лабораторная программа».', small: true },
      { t: 'h', text: '5. Медицинские осмотры и гигиеническое обучение' }, { t: 'table', head: ['Требование', 'Должности', 'Периодичность'], rows: Pack.rows(S.prof, 3), widths: [5, 6, 4] },
      { t: 'h', text: '6. Ответственные' }, { t: 'table', head: ['ФИО', 'Должность', 'Функции'], rows: Pack.rows(S.officials, 3), widths: [4, 3, 8] },
      { t: 'p', text: 'Ответственные за отдельные журналы устанавливаются приказом.' },
      { t: 'h', text: '7. Аварийные ситуации' }, { t: 'table', head: ['Ситуация', 'Действия'], rows: Pack.rows(S.emerg, 2), widths: [4, 10] },
      { t: 'h', text: '8. Несоответствия' }, { t: 'p', text: 'При отклонении продукция идентифицируется и блокируется. Определяется причина, выполняется повторный контроль, принимается решение об исправлении, переработке (если допустимо), возврате или утилизации. Действия фиксируются в журнале несоответствий.' },
      { t: 'h', text: '9. Пересмотр' }, { t: 'p', text: 'ППК пересматривается при изменении ассортимента, рецептур, оборудования, помещений, поставщиков, требований законодательства, выявлении несоответствий и по результатам внутреннего аудита' + (rec.review_due_date ? ', но не позднее ' + fmtD(rec.review_due_date) : '') + '.' },
      { t: 'h', text: '10. Утверждение' }, approve]);
    add('ППК программа производственного контроля', ppc);

    /* 02 План ХАССП */
    var team = [['Руководитель', boss, 'утверждение, ресурсы']];
    if (resp.length) resp.forEach(function (r) { team.push([r[1] || 'Ответственный', r[0], r[2]]); });
    else { team.push(['Ответственный за ХАССП', boss + '*', 'анализ рисков, записи'], ['Производственный контроль', boss + '*', 'санитария, журналы']); }
    staff.forEach(function (s) { team.push([s[1] || 'Работник производства', s[0], 'операционный контроль']); });
    if (!staff.length) team.push(['Работник производства', '________________', 'операционный контроль']);
    var haz = [['Приём', 'Б: патогены; Х: химия; Ф: включения', 'документы, маркировка, срок, температура, целостность', 'КП'], ['Хранение', 'рост микроорганизмов; перекрёстная контаминация', 'температура по ТД продукта, раздельность', 'КП'], ['Подготовка', 'перекрёстное загрязнение', 'раздельный инвентарь, санитария, контроль времени', 'КП']];
    if (vac) haz.push(['Вакуумирование', 'микробиологические риски; упаковка', 'разрешённая упаковка, герметичность, маркировка', sv ? 'КП/ККТ*' : 'КП']);
    if (sv) haz.push(['Sous-vide', 'выживание/рост патогенов', 'валидированный режим температура-время', 'ККТ']);
    if (fr) haz.push(['Жарка/томление', 'недостаточная термообработка', 'температура в контрольной точке и время по ТТК', 'ККТ']);
    if (!sv && !fr && Pack.has(P, 'hot_shop')) haz.push(['Термообработка', 'выживание патогенов', 'режим по ТТК, температура в толще продукта', 'ККТ']);
    if (cool) haz.push(['Охлаждение', 'рост микроорганизмов', 'режим охлаждения по ТТК', 'ККТ*']);
    if (Pack.has(P, 'cold_shop')) haz.push(['Приготовление без термообработки', 'вторичное загрязнение', 'раздельный инвентарь, обработка сырья, сроки реализации', 'КП']);
    haz.push(['Хранение', 'рост/перекрёстное загрязнение', 'температура, срок, маркировка', 'КП'], ['Продажа', 'нарушение срока/условий; аллергены', 'маркировка, срок, условия, информация', 'КП']);
    var haccp = H('План ХАССП / система управления безопасностью пищевой продукции').concat([
      { t: 'p', text: 'Система построена на анализе биологических, химических и физических опасностей, предварительных санитарных программах, ККТ, критических пределах, мониторинге, корректирующих действиях, верификации и документировании.' },
      { t: 'h', text: 'Команда ХАССП' }, { t: 'table', head: ['Роль', 'ФИО', 'Функция'], rows: team, widths: [4, 5, 6] }, resp.length ? { t: 'p', text: '' } : { t: 'p', text: '* До назначения отдельного ответственного.', small: true },
      { t: 'h', text: 'Блок-схема' }, { t: 'p', text: Pack.chain(P).replace(/^приём сырья/, 'Приём') + '. Отходы и уборочный инвентарь — отдельными потоками.' },
      { t: 'h', text: 'Анализ опасностей' }, { t: 'table', head: ['Этап', 'Опасности', 'Меры управления', 'Статус'], rows: haz, widths: [3, 5, 6, 2] }]);
    var ccp = Pack.rows(S.ccp, 4);
    if (ccp.length) haccp.push({ t: 'h', text: 'Опасные факторы и критические контрольные точки по нормативной базе' }, { t: 'table', head: ['Процесс / этап', 'Опасный фактор', 'Критический предел / требование', 'Мониторинг'], rows: ccp, widths: [4, 4, 5, 4] });
    haccp.push({ t: 'p', text: 'Критические пределы ' + (procTxt || 'термообработки') + (cool ? ' и охлаждения' : '') + ' заполняются только по конкретным ТТК/валидации продукта, толщины, упаковки и оборудования; значения из чужих документов не переносить.' },
      { t: 'h', text: 'Верификация' }, { t: 'p', text: 'Ежедневно — проверка записей и отклонений; еженедельно — внутренний санитарный контроль; периодически — метрология, лабораторные протоколы, сроки годности и пересмотр рисков; внепланово — после изменений или серьёзного несоответствия.' });
    add('ХАССП план безопасности пищевой продукции', haccp);

    /* 03 Приказы */
    var orders = [['01-ППК', 'Об утверждении ППК', 'Утвердить ППК и ввести в действие с ' + date + '.'], ['02-ХАССП', 'О внедрении ХАССП', 'Утвердить план ХАССП и обязательность записей ККТ.'], ['03-ХАССП', 'О назначении ответственных', 'Назначить ответственных за ХАССП, приёмку, санитарию и журналы.'], ['04-САН', 'О мойке и дезинфекции', 'Утвердить график уборки и контроль дезрастворов.']];
    if (th) orders.push(['05-ККТ', 'О контроле термообработки', 'Регистрировать ККТ каждой партии/цикла.']);
    orders.push(['06-ЛАБ', 'О лабораторной программе', 'Утвердить программу и хранение протоколов.'], ['07-ОТЗ', 'О несоответствиях и отзыве', 'Блокировать продукцию и оформлять корректирующие действия.'], ['08-ДОП', 'О допуске персонала', 'Соблюдать медосмотры, гигиену и недопуск заболевших.']);
    add('Приказы и распоряжения', H('Приказы и распоряжения').concat([{ t: 'table', head: ['№', 'Документ', 'Распоряжение'], rows: orders, widths: [2, 5, 9] }, { t: 'h', text: 'Шаблон приказа' },
      { t: 'p', text: 'ПРИКАЗ № ____ от «___» __________ ' + year + ' г.\nОснование: ППК/ХАССП предприятия.\nРАСПОРЯЖАЮСЬ: ____________________________________________\nКонтроль исполнения: ' + sh + '.\nПодпись: __________________\nОзнакомлены: ______________________________' }]));

    /* 04 Схема потоков */
    var equip = Pack.lines(P.equipment, 2);
    if (!equip.length) { equip = [['Холодильник', '__'], ['Морозильник', '__']]; if (vac) equip.push(['Вакууматор', '__']); if (sv) equip.push(['Sous-vide', '__']); if (fr) equip.push(['Жарочное', '__'], ['Томильное', '__']); equip.push(['Весы', '__'], ['Термометры', '__'], ['Моечная ванна', '__']); }
    add('2D план потоков и зонирование', H('2D план потоков и зонирование').concat([
      { t: 'p', text: 'Функциональная схема для объекта' + (P.area ? ' ' + P.area + ' м²' : '') + '. Это не архитектурный план: фактические размеры, двери, окна, точки воды/канализации и оборудование необходимо сверить с объектом.' },
      { t: 'table', head: ['Приём/вход', 'Хранение', 'Заготовка', th ? 'Термообработка' : 'Приготовление', 'Упаковка/продажа'], rows: [['↓ сырьё', 'холодильник/морозильник', 'столы/инвентарь', procTxt || 'по технологии', 'маркировка → клиент'], ['проверка', 'раздельное хранение', 'санитарный контроль', th ? 'ККТ T°/время' : 'контроль режимов', 'контроль срока'], ['документы', 'FIFO/FEFO', 'сырьё → продукт', 'партия', 'выдача']], widths: [1, 1, 1, 1, 1] },
      { t: 'h', text: 'Потоки' }, { t: 'p', text: 'Сырьё: вход → приём → хранение → заготовка → ' + (th ? 'термообработка → ' : '') + (vac ? 'упаковка/' : '') + 'маркировка → продажа.\nОтходы: рабочая зона → закрытая промаркированная тара → вынос без пересечения с готовой продукцией.\nУборочный инвентарь хранится отдельно от пищевой продукции и упаковки.\nПерсонал: вход → гигиена рук → рабочая зона; уличная одежда отдельно.\nВстречные потоки сырого и готового продукта исключаются организационно и/или по времени.' },
      { t: 'h', text: 'Фактический перечень оборудования' + (V.str(P.equipment) ? '' : ' — заполнить') }, { t: 'table', head: ['Оборудование', 'Кол-во', 'Место', 'Инв. №'], rows: equip.map(function (e) { return [e[0], e[1] || '__', '', '']; }), widths: [5, 2, 4, 3] }]));

    /* 05 Реестр документов предприятия (+ ТУ клиента из системы) */
    var reg = [['ППК', rec.status === 'APPROVED' ? 'утверждена' : 'утвердить', 'папка ППК', 'при изменениях/ежегодно'], ['План ХАССП', 'утвердить', 'папка ХАССП', 'при изменениях/аудите']];
    var specs = Repo.where('TechSpecs', function (x) { return x.client_id === rec.client_id && x.status !== 'ARCHIVED'; });
    if (specs.length) specs.forEach(function (x) { reg.push([x.designation + ' «' + x.product_name + '»', x.status === 'APPROVED' ? 'утверждены' : 'проект', 'папка соответствия', 'актуальность']); });
    else reg.push(['ТУ', P.tu_declarations ? 'по данным предприятия' : 'внести', 'папка соответствия', 'актуальность']);
    reg.push(['Декларации', P.tu_declarations ? 'по данным предприятия' : 'внести', 'папка соответствия', 'срок/область'], ['ТТК', 'по всему ассортименту', 'папка ТТК', 'при изменении рецептуры'], ['Документы поставщиков', 'по группам сырья', 'папка поставщиков', 'при смене'], ['Документы на химсредства', 'внести фактические', 'папка санитарии', 'при смене'],
      ['Медицинские документы', 'по каждому работнику', 'кадровая папка', 'по срокам'], ['Лабораторные протоколы', 'по программе', 'папка ППК', 'по графику'], ['Поверка/калибровка', 'по приборам', 'папка метрологии', 'по срокам']);
