var NormSeed = {
  /* Однократно: при пустой нормативной базе */
  run: function (ownerEmp) {
    var have = indexBy(Store.all('NormDocs'), 'code');
    var ctx = Seed.ctx(ownerEmp, Integr.now()), n = 0, added = 0;
    /* Миграция: СанПиН 3590-20 и СП 3670-20, внесённые как проект со старым сроком, получают срок окончания из справки */
    ['СанПиН 2.3/2.4.3590-20', 'СП 2.2.3670-20'].forEach(function (code) {
      var d = have[code], seed = filterBy(NORM_SEED, function (x) { return x.code === code; })[0];
      if (d && seed && seed.validUntil && !V.bool(d.verified) && (!d.valid_until || isBefore(seed.validUntil, d.valid_until))) {
        Repo.update(ctx, 'NormDocs', d.norm_id, { valid_until: new Date(seed.validUntil).toISOString(), notes: seed.notes }, { action: 'NORM_SEED' });
      }
    });
    NORM_SEED.forEach(function (d) {
      if (have[d.code]) return;
      added++;
      var doc = Repo.create(ctx, 'NormDocs', {
        code: d.code, title: d.title, kind: d.kind, status: 'ACTIVE', scopes: d.scopes, valid_from: d.validFrom ? new Date(d.validFrom).toISOString() : '', valid_until: d.validUntil ? new Date(d.validUntil).toISOString() : '',
        verified: !!d.v, verified_by: d.v ? ctx.actorId : '', verified_at: d.v ? ctx.now : '', source_url: d.source || '', notes: d.notes || ''
      }, { action: 'NORM_SEED', noAudit: true });
      (d.items || []).forEach(function (it, i) {
        Repo.create(ctx, 'NormItems', {
          norm_id: doc.norm_id, section: it[0], clause: it[1], text: it[2], applies: it[3] || 'all', product_group: it[4], indicator: it[5], norm_value: it[6],
          frequency: it[7], volume: it[8], sort_order: (i + 1) * 10, active: true, verified: !!d.v
        }, { noAudit: true });
        n++;
      });
    });
    if (!added) return 0;
    Audit.log(ctx, 'NORM_SEED', 'NormDocs', 'seed', null, { docs: added, items: n });
    return n;
  }
};
