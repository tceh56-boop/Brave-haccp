var NormSeed = {
  docFields: function (d, ctx) {
    return {
      code: d.code, title: d.title, kind: d.kind, scopes: d.scopes, valid_from: d.validFrom ? new Date(d.validFrom).toISOString() : '', valid_until: d.validUntil ? new Date(d.validUntil).toISOString() : '',
      verified: !!d.v, verified_by: d.v ? ctx.actorId : '', verified_at: d.v ? ctx.now : '', source_url: d.source || '', notes: d.notes || ''
    };
  },
  addItems: function (ctx, normId, d) {
    (d.items || []).forEach(function (it, i) {
      Repo.create(ctx, 'NormItems', {
        norm_id: normId, section: it[0], clause: it[1], text: it[2], applies: it[3] || 'all', product_group: it[4], indicator: it[5], norm_value: it[6],
        frequency: it[7], volume: it[8], sort_order: (i + 1) * 10, active: true, verified: !!d.v
      }, { noAudit: true });
    });
    return (d.items || []).length;
  },
  /* Добавляет недостающие документы; документы, ещё не сверенные пользователем, обновляет до текущего наполнения.
     Положения, которые пользователь сверил сам, не трогаются; несверенные старые положения выключаются (не удаляются). */
  run: function (ownerEmp) {
    var have = indexBy(Store.all('NormDocs'), 'code');
    var ctx = Seed.ctx(ownerEmp, Integr.now()), n = 0, added = 0, refreshed = 0;
    NORM_SEED.forEach(function (d) {
      var x = have[d.code];
      if (!x) {
        added++;
        var f = NormSeed.docFields(d, ctx); f.status = 'ACTIVE';
        var doc = Repo.create(ctx, 'NormDocs', f, { action: 'NORM_SEED', noAudit: true });
        n += NormSeed.addItems(ctx, doc.norm_id, d);
        return;
      }
      if (V.bool(x.verified)) {
        /* Сверенный документ обновляется, только если пользователь не менял его (примечание совпадает с прежней поставкой) */
        if (!d.prevNotes || d.prevNotes.indexOf(String(x.notes || '')) < 0) return;
        refreshed++;
        var f2 = NormSeed.docFields(d, ctx); f2.verified_by = x.verified_by; f2.verified_at = x.verified_at;
        Repo.update(ctx, 'NormDocs', x.norm_id, f2, { action: 'NORM_SEED' });
        var mine = filterBy(Store.all('NormItems'), function (i) { return i.norm_id === x.norm_id && V.bool(i.active); });
        mine.forEach(function (i) { if ((d.drop || []).indexOf(i.clause) >= 0) Repo.update(ctx, 'NormItems', i.norm_item_id, { active: false }, { noAudit: true }); });
        var key = function (sec, cl, t) { return sec + '|' + cl + '|' + t; }, have2 = {};
        mine.forEach(function (i) { have2[key(i.section, i.clause, i.text)] = true; });
        n += NormSeed.addItems(ctx, x.norm_id, { v: d.v, items: filterBy(d.items || [], function (it) { return (d.drop || []).indexOf(it[1]) < 0 && !have2[key(it[0], it[1], it[2])]; }) });
        return;
      }
      if ((d.v || d.refresh) && String(x.notes || '') !== String(d.notes || '')) {
        refreshed++;
        Repo.update(ctx, 'NormDocs', x.norm_id, NormSeed.docFields(d, ctx), { action: 'NORM_SEED' });
        Store.all('NormItems').forEach(function (i) {
          if (i.norm_id === x.norm_id && V.bool(i.active) && !V.bool(i.verified)) Repo.update(ctx, 'NormItems', i.norm_item_id, { active: false }, { noAudit: true });
        });
        n += NormSeed.addItems(ctx, x.norm_id, d);
      } else if (d.validUntil && (!x.valid_until || isBefore(d.validUntil, x.valid_until))) {
        Repo.update(ctx, 'NormDocs', x.norm_id, { valid_until: new Date(d.validUntil).toISOString(), notes: d.notes || '' }, { action: 'NORM_SEED' });
      }
    });
    if (!added && !refreshed) return 0;
    Audit.log(ctx, 'NORM_SEED', 'NormDocs', 'seed', null, { docs: added, refreshed: refreshed, items: n });
    return n;
  }
};
