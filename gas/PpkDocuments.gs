/** Document facade; keeps document generation deterministic and source-aware. */
function getPpkDocument_(session,data){data=data||{};var c=_ppkCtx_(session,data.locationId);if(!data.ppkId){var w=getWorkingPpk_(c.organizationId);if(!w)throw new Error('ППК ещё не создана — нажмите «Собрать / обновить модель ППК».');data.ppkId=w.ppk_id;}var docs=_ppkRows_('PPK_DOCUMENTS',c.organizationId,c.locationId).filter(function(x){return x.ppk_id===data.ppkId;});return docs[docs.length-1]||generatePpkDocument_(session,data);}
