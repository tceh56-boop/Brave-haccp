/** Mon Chef V42 — Sanitation / disinfectant operational engine.
 * V41 is the reference master. V42 turns approved regimes into executable tasks,
 * records actual execution/control facts, tracks solution use and stock alerts.
 * No regulatory concentration or exposure is invented here.
 */
const V42_SAN = {
  AREA:'Санитария_Зоны_V42',
  PLAN:'Санитария_Планы_V42',
  EXEC:'Санитария_Выполнение_V42',
  CONTROL:'Санитария_Контроль_V42',
  STOCK:'Санитария_Остатки_V42',
  ALERT:'Санитария_Алерты_V42'
};
const V42_HEADERS = {
  AREA:['AreaID','AreaName','Workshop','ObjectType','Frequency','Active','Notes'],
  PLAN:['PlanID','AreaID','TaskName','RegimeID','DisinfectantID','DueAt','AssignedTo','Priority','Status','SolutionRequired','ControlRequired','CreatedAt','CompletedAt','CompletedBy','ExecutionFactID','ControlFactID','Notes'],
  EXEC:['ExecutionID','PlanID','DateTime','EmployeeID','AreaID','RegimeID','DisinfectantID','SolutionID','Method','ExposureMin','RinseRequired','Result','FactID','DeviationID','Notes'],
  CONTROL:['ControlID','PlanID','SolutionID','DateTime','EmployeeID','DisinfectantID','MeasuredValue','Unit','ExpectedRaw','Result','Method','FactID','DeviationID','Notes'],
  STOCK:['StockID','DisinfectantID','ProductName','LotNo','Qty','Unit','ReceivedAt','ExpiresAt','MinQty','Location','Status','UpdatedAt','Notes'],
  ALERT:['AlertID','AlertType','ObjectID','DateTime','Severity','Message','Status','RelatedTaskID','RelatedStockID','CreatedAt','ResolvedAt']
};
function setupV42Sanitation(){ Object.keys(V42_HEADERS).forEach(k=>_v42Sheet_(V42_SAN[k],V42_HEADERS[k])); return {ok:true,sheets:V42_SAN}; }
function _v42Sheet_(name,headers){ var ss=_book_(); var sh=ss.getSheetByName(name); if(!sh) sh=ss.insertSheet(name); if(sh.getLastRow()===0){ sh.appendRow(headers); sh.setFrozenRows(1); } return sh; }  // закрепление — только при создании: чтение раздела не пишет в таблицу
function _v42Id_(p){ return 'SAN42-'+p+'-'+Utilities.getUuid().slice(0,8).toUpperCase(); }
function _v42Rows_(name){ var sh=_book_().getSheetByName(name); if(!sh||sh.getLastRow()<2)return []; var v=sh.getDataRange().getValues(), h=v[0]; return v.slice(1).filter(function(r){return r.some(function(x){return x!=='';});}).map(function(r){var o={};h.forEach(function(k,i){o[k]=r[i];});return o;}); }
function _v42Find_(sheetName,key,value){ var sh=_book_().getSheetByName(sheetName); if(!sh)return null; var v=sh.getDataRange().getValues(),h=v[0],ix=h.indexOf(key); if(ix<0)return null; for(var i=1;i<v.length;i++)if(String(v[i][ix])===String(value)){var o={};h.forEach(function(k,j){o[k]=v[i][j];});o._row=i+1;return o;} return null; }
function _v42ApprovedRegime_(regimeId){ var r=_v42Find_('Дезсредства_Режимы_V41','RegimeID',regimeId); if(!r||String(r.ApprovalStatus)!=='APPROVED') throw new Error('Режим не утверждён: '+regimeId); var d=_v42Find_('Дезсредства_V41','DisinfectantID',r.DisinfectantID); if(!d||String(d.ApprovalStatus)!=='APPROVED'||String(d.AllowedForCatering)!=='YES') throw new Error('Средство не утверждено для общепита: '+r.DisinfectantID); return {regime:r,disinfectant:d}; }
function _v42ParseMin_(raw){ var m=String(raw||'').match(/(\d+(?:[.,]\d+)?)\s*(?:-|–|—|до)\s*(\d+(?:[.,]\d+)?)\s*мин/i); if(!m){m=String(raw||'').match(/(\d+(?:[.,]\d+)?)\s*мин/i); if(m)return Number(m[1].replace(',','.')); return null;} return Number(m[1].replace(',','.')); }
function _v42ParsePercentRange_(raw){ var s=String(raw||'').replace(/,/g,'.'); var m=s.match(/(\d+(?:\.\d+)?)\s*(?:-|–|—|до)\s*(\d+(?:\.\d+)?)\s*%/); if(m)return {min:Number(m[1]),max:Number(m[2])}; m=s.match(/(\d+(?:\.\d+)?)\s*%/); if(m)return {min:Number(m[1]),max:Number(m[1])}; return null; }
function v42SeedAreas(){ setupV42Sanitation(); var sh=_book_().getSheetByName(V42_SAN.AREA); if(sh.getLastRow()>1)return {ok:true,seeded:false,count:sh.getLastRow()-1}; var rows=[
 ['AREA-KITCHEN-COLD','Холодный цех','Холодный цех','Поверхности','Ежедневно',true,''],
 ['AREA-KITCHEN-HOT','Горячий цех','Горячий цех','Поверхности','Ежедневно',true,''],
 ['AREA-PREP','Полуфабрикаты','Полуфабрикаты','Поверхности и инвентарь','Ежедневно',true,''],
 ['AREA-CONF','Кондитерский цех','Кондитерский цех','Поверхности','Ежедневно',true,''],
 ['AREA-DISH','Моечная','Моечная','Посуда и инвентарь','Ежедневно',true,''],
 ['AREA-SAN','Санитарная зона','Санитарная зона','Сантехника','Ежедневно',true,'']
 ]; sh.getRange(2,1,rows.length,rows[0].length).setValues(rows); return {ok:true,seeded:true,count:rows.length}; }
function v42CreatePlan(p,token){ setupV42Sanitation(); p=p||{}; if(!p.areaId||!p.taskName||!p.regimeId||!p.dueAt)throw new Error('Заполните зону, задачу, режим обработки и срок'); var x=_v42ApprovedRegime_(p.regimeId), sh=_book_().getSheetByName(V42_SAN.PLAN), now=new Date(), id=_v42Id_('TASK'); sh.appendRow([id,p.areaId,p.taskName,p.regimeId,x.regime.DisinfectantID,new Date(p.dueAt),p.assignedTo||'',p.priority||'NORMAL','OPEN',p.solutionRequired!==false,p.controlRequired!==false,now,'','','','',p.notes||'']); return {ok:true,planId:id,regime:x.regime,disinfectant:x.disinfectant}; }
function v42CompletePlan(p,token){ setupV42Sanitation(); p=p||{}; if(!p.planId)throw new Error('Выберите план уборки'); var plan=_v42Find_(V42_SAN.PLAN,'PlanID',p.planId); if(!plan)throw new Error('task not found'); if(String(plan.Status)==='DONE')return {ok:true,id:p.planId,idempotent:true}; var x=_v42ApprovedRegime_(plan.RegimeID), now=new Date(), execId=_v42Id_('EXEC'), factId=_v42Id_('FACT'), esh=_book_().getSheetByName(V42_SAN.EXEC), psh=_book_().getSheetByName(V42_SAN.PLAN); esh.appendRow([execId,plan.PlanID,now,p.employeeId||p.completedBy||'',plan.AreaID,plan.RegimeID,plan.DisinfectantID,p.solutionId||'',x.regime.Method||'',_v42ParseMin_(x.regime.ExposureRaw),x.regime.RinseRequired||'',p.result||'OK',factId,p.deviationId||'',p.notes||'']); var row=plan._row, h=psh.getRange(1,1,1,psh.getLastColumn()).getValues()[0]; psh.getRange(row,h.indexOf('Status')+1).setValue('DONE'); psh.getRange(row,h.indexOf('CompletedAt')+1).setValue(now); psh.getRange(row,h.indexOf('CompletedBy')+1).setValue(p.completedBy||p.employeeId||''); psh.getRange(row,h.indexOf('ExecutionFactID')+1).setValue(factId); return {ok:true,executionId:execId,factId:factId}; }
function v42RecordControl(p,token){ setupV42Sanitation(); p=p||{}; if(!p.planId||!p.solutionId||!p.disinfectantId)throw new Error('Выберите план, рабочий раствор и дезсредство'); var sol=_v42Find_('Дезсредства_Растворы_V41','SolutionID',p.solutionId); if(!sol)throw new Error('solution not found'); var d=_v42Find_('Дезсредства_V41','DisinfectantID',p.disinfectantId); if(!d||String(d.ApprovalStatus)!=='APPROVED'||String(d.AllowedForCatering)!=='YES')throw new Error('disinfectant not approved for catering'); var plan=_v42Find_(V42_SAN.PLAN,'PlanID',p.planId); if(!plan)throw new Error('plan not found'); var regime=_v42ApprovedRegime_(plan.RegimeID).regime, range=_v42ParsePercentRange_(regime.ConcentrationRaw), val=Number(String(p.measuredValue||'').replace(',','.')), result=((range&&isFinite(val))?(val>=range.min&&val<=range.max?'OK':'DEVIATION'):'REVIEW'), id=_v42Id_('CTRL'), factId=_v42Id_('FACT'), now=new Date(), sh=_book_().getSheetByName(V42_SAN.CONTROL); sh.appendRow([id,p.planId,p.solutionId,now,p.employeeId||'',p.disinfectantId,p.measuredValue||'',p.unit||'%',regime.ConcentrationRaw||'',result,p.method||'',''+factId,p.deviationId||'',p.notes||'']); if(result==='DEVIATION')v42CreateAlert_('CONCENTRATION_DEVIATION',p.solutionId, 'CRITICAL','Концентрация рабочего раствора вне утверждённого режима',p.planId,''); return {ok:true,controlId:id,factId:factId,result:result,expected:regime.ConcentrationRaw,parsedRange:range}; }
function v42ConsumeSolution(p,token){ setupV42Sanitation(); p=p||{}; if(!p.solutionId||p.qty===undefined)throw new Error('Выберите раствор и укажите количество'); var sol=_v42Find_('Дезсредства_Растворы_V41','SolutionID',p.solutionId); if(!sol)throw new Error('solution not found'); var stockId=p.stockId||''; var sh=_book_().getSheetByName(V42_SAN.STOCK), rows=sh.getDataRange().getValues(), h=rows[0], idx=h.indexOf('StockID'); if(stockId){for(var i=1;i<rows.length;i++)if(String(rows[i][idx])===String(stockId)){var qix=h.indexOf('Qty'), q=Number(rows[i][qix]||0)-Number(p.qty||0);if(q<0)throw new Error('Недостаточно остатка');sh.getRange(i+1,qix+1).setValue(q);sh.getRange(i+1,h.indexOf('UpdatedAt')+1).setValue(new Date());return {ok:true,stockId:stockId,remaining:q};}} throw new Error('Выберите остаток на складе для списания'); }
function v42AddStock(p,token){ setupV42Sanitation(); p=p||{}; if(!p.disinfectantId||!p.qty)throw new Error('Выберите дезсредство и укажите количество'); var d=_v42Find_('Дезсредства_V41','DisinfectantID',p.disinfectantId); if(!d||String(d.ApprovalStatus)!=='APPROVED')throw new Error('Средство не утверждено'); var sh=_book_().getSheetByName(V42_SAN.STOCK), id=_v42Id_('STK'); sh.appendRow([id,p.disinfectantId,d.ProductName,p.lotNo||'',Number(p.qty),p.unit||'л',p.receivedAt?new Date(p.receivedAt):new Date(),p.expiresAt?new Date(p.expiresAt):'',Number(p.minQty||0),p.location||'', 'ACTIVE',new Date(),p.notes||'']); return {ok:true,stockId:id}; }
function v42BuildAlerts(){ setupV42Sanitation(); var now=new Date(), alerts=[]; var sol=_v42Rows_('Дезсредства_Растворы_V41'); sol.forEach(function(s){if(String(s.Status)==='ACTIVE'&&s.ExpiresAt instanceof Date&&s.ExpiresAt<now){alerts.push(v42CreateAlert_('SOLUTION_EXPIRED',s.SolutionID,'HIGH','Рабочий раствор просрочен', '', ''));}}); var st=_v42Rows_(V42_SAN.STOCK); st.forEach(function(s){var q=Number(s.Qty||0),min=Number(s.MinQty||0);if(String(s.Status)==='ACTIVE'&&min>0&&q<=min)alerts.push(v42CreateAlert_('LOW_STOCK',s.StockID,'MEDIUM','Остаток дезсредства ниже минимального', '',s.StockID));if(String(s.Status)==='ACTIVE'&&s.ExpiresAt instanceof Date&&s.ExpiresAt<now)alerts.push(v42CreateAlert_('STOCK_EXPIRED',s.StockID,'HIGH','Просрочена партия дезсредства', '',s.StockID));}); return {ok:true,created:alerts.length}; }
function v42CreateAlert_(type,obj,severity,message,task,stock){ var sh=_book_().getSheetByName(V42_SAN.ALERT)||_v42Sheet_(V42_SAN.ALERT,V42_HEADERS.ALERT), id=_v42Id_('ALT'), now=new Date(); sh.appendRow([id,type,obj,now,severity,message,'OPEN',task||'',stock||'',now,'']); return id; }
function v42GetDashboard(){ setupV42Sanitation(); var out={}; Object.keys(V42_SAN).forEach(function(k){var sh=_book_().getSheetByName(V42_SAN[k]);out[V42_SAN[k]]=sh?Math.max(0,sh.getLastRow()-1):0;}); return out; }
