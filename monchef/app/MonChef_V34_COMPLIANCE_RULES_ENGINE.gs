/**
 * MON CHEF V34 — COMPLIANCE RULES / CONTROL COVERAGE ENGINE
 * Нормативная матрица превращается в исполняемые правила контроля.
 * Юридический статус требований хранится отдельно от методических ГОСТ.
 */
var MC_V34={RULE:'Правила_Контроля_V34',COVER:'Покрытие_Контролей_V34',TASK:'Задачи_Соответствия_V34',EVID:'Доказательства_V34'};
function _v34Sheet_(n,h){var s=_book_().getSheetByName(n);if(!s){s=_book_().insertSheet(n);s.appendRow(h);s.setFrozenRows(1);}return s;}
function _v34Init_(){
 _v34Sheet_(MC_V34.RULE,['RuleID','RequirementID','Trigger','ObjectType','EvidenceType','Frequency','SLA_Min','Criticality','AutoTask','BlockOnCritical','OwnerRole','Active','Notes']);
 _v34Sheet_(MC_V34.COVER,['CoverageID','RuleID','RequirementID','ObjectType','ObjectID','Period','Expected','Actual','Result','LastFactAt','EvidenceID','DeviationID','CheckedAt','Status']);
 _v34Sheet_(MC_V34.TASK,['TaskID','RuleID','RequirementID','ObjectType','ObjectID','DueAt','Priority','OwnerRole','Status','RelatedFactID','DeviationID','CreatedAt','CreatedBy']);
 _v34Sheet_(MC_V34.EVID,['EvidenceID','RequirementID','ObjectType','ObjectID','EvidenceType','SourceType','SourceID','CapturedAt','CapturedBy','Hash','Status','Notes']);
}
function _v34Rows_(n){var s=_book_().getSheetByName(n);if(!s)return[];var v=s.getDataRange().getValues();return v.length>1?v.slice(1):[];}
function _v34SeedRules_(){
 _v34Init_(); var s=_v34Sheet_(MC_V34.RULE,['RuleID','RequirementID','Trigger','ObjectType','EvidenceType','Frequency','SLA_Min','Criticality','AutoTask','BlockOnCritical','OwnerRole','Active','Notes']);
 if(s.getLastRow()>1)return;
 var rows=[
 ['RULE-REC-001','REQ-REC-001','RECEIVING_CONFIRMED','RECEIVING','RECEIVING_RECORD','Каждая поставка',0,'HIGH',true,true,'Приёмщик',true,'Приёмка не считается завершённой без подтверждения маркировки и сопроводительных документов.'],
 ['RULE-STO-001','REQ-HACCP-006','SHIFT_START','REFRIGERATOR','FACT','По плану мониторинга',60,'HIGH',true,true,'Ответственный смены',true,'Создаёт задачу фактического контроля температуры.'],
 ['RULE-PROD-001','REQ-HACCP-006','PRODUCTION_COMPLETED','BATCH','FACT','По плану мониторинга',30,'HIGH',true,true,'Ответственный производства',true,'Применяется только если утверждённый план мониторинга привязан к событию.'],
 ['RULE-SAN-001','REQ-SAN-001','SCHEDULE','SANITATION_ZONE','TASK+FACT','По графику',0,'MEDIUM',true,false,'Ответственный за санитарию',true,'Контроль выполнения санитарной операции.'],
 ['RULE-PER-001','REQ-HYG-001','SHIFT_START','EMPLOYEE','CHECKLIST','Каждая смена',0,'HIGH',true,true,'Ответственный смены',true,'Проверка допуска перед началом смены.'],
 ['RULE-LAB-001','REQ-HACCP-007','SCHEDULE','LAB_PROGRAM','LAB_REPORT','По ППК',0,'HIGH',true,false,'Ответственный за ППК',true,'Задача создаётся по утверждённой программе лабораторного контроля.'],
 ['RULE-TRACE-001','REQ-TRACE-001','BATCH_CREATED','BATCH','TRACE_CHAIN','Каждая партия',0,'HIGH',true,true,'Склад/производство',true,'Проверка наличия связей сырьё → производство → партия.'],
 ['RULE-DOC-001','REQ-DOC-001','CONTROL_COMPLETED','CONTROL','FACT+DOC','По ППК',0,'HIGH',true,false,'Ответственный за ППК',true,'Контроль наличия документированного результата.']
 ]; s.getRange(2,1,rows.length,rows[0].length).setValues(rows);
}
function setupV34ComplianceRules(token){try{_requireAuth_(token,'journals');_v34SeedRules_();return _ok_({initialized:true,rules:_v34Rows_(MC_V34.RULE).length},'V34_SETUP');}catch(e){return _failFrom_(e);}}
function v34GetRules(token){try{_requireAuth_(token,'journals');_v34SeedRules_();return _ok_({rules:_v34Rows_(MC_V34.RULE)},'V34_RULES');}catch(e){return _failFrom_(e);}}
function _v34FindRule_(id){return _v34Rows_(MC_V34.RULE).filter(function(r){return String(r[0])===String(id)&&String(r[11]).toUpperCase()!=='FALSE';})[0]||null;}
function v34CreateComplianceTask(json,token){var op=null;try{op=_beginOp_(token,'journals','V34_TASK','Create compliance task',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v34SeedRules_();var d=typeof json==='string'?JSON.parse(json||'{}'):(json||{});if(!d.ruleId)throw new Error('ruleId обязателен');var r=_v34FindRule_(d.ruleId);if(!r)throw new Error('Правило не найдено или неактивно');var id=d.taskId||'C34-'+Utilities.getUuid();var due=d.dueAt?new Date(d.dueAt):new Date(Date.now()+Number(r[6]||0)*60000);_v34Sheet_(MC_V34.TASK,['TaskID','RuleID','RequirementID','ObjectType','ObjectID','DueAt','Priority','OwnerRole','Status','RelatedFactID','DeviationID','CreatedAt','CreatedBy']).appendRow([id,r[0],r[1],d.objectType||r[3],d.objectId||'',due,String(r[7]||'MEDIUM'),d.ownerRole||r[10],'OPEN',d.relatedFactId||'',d.deviationId||'',new Date(),_mcSessionFullName_(op.session)]);_audit_(op,'V34_TASK','COMPLIANCE_TASK',id,null,{ruleId:r[0],objectId:d.objectId||''});_endOp_(op);return _ok_({taskId:id,dueAt:due},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v34RecordEvidence(json,token){var op=null;try{op=_beginOp_(token,'journals','V34_EVID','Record compliance evidence',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v34SeedRules_();var d=typeof json==='string'?JSON.parse(json||'{}'):(json||{});if(!d.requirementId||!d.evidenceType)throw new Error('requirementId и evidenceType обязательны');var id=d.evidenceId||'E34-'+Utilities.getUuid();_v34Sheet_(MC_V34.EVID,['EvidenceID','RequirementID','ObjectType','ObjectID','EvidenceType','SourceType','SourceID','CapturedAt','CapturedBy','Hash','Status','Notes']).appendRow([id,d.requirementId,d.objectType||'',d.objectId||'',d.evidenceType,d.sourceType||'SYSTEM',d.sourceId||'',new Date(),_mcSessionFullName_(op.session),d.hash||'',d.status||'VALID',d.notes||'']);_audit_(op,'V34_EVID','COMPLIANCE_EVIDENCE',id,null,{requirementId:d.requirementId});_endOp_(op);return _ok_({evidenceId:id},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v34BuildCoverage(token){try{_requireAuth_(token,'journals');_v34SeedRules_();var rules=_v34Rows_(MC_V34.RULE).filter(function(r){return String(r[11]).toUpperCase()!=='FALSE';});var ev=_v34Rows_(MC_V34.EVID),tasks=_v34Rows_(MC_V34.TASK),out=rules.map(function(r){var ee=ev.filter(function(x){return String(x[1])===String(r[1])&&String(x[10]).toUpperCase()!=='REVOKED';});var tt=tasks.filter(function(x){return String(x[1])===String(r[0])&&String(x[8]).toUpperCase()==='OPEN';});return{ruleId:r[0],requirementId:r[1],trigger:r[2],objectType:r[3],criticality:r[7],evidenceCount:ee.length,openTasks:tt.length,result:ee.length?'COVERED':'MISSING_EVIDENCE',lastEvidenceAt:ee.length?ee[ee.length-1][7]:'',ownerRole:r[10],blockOnCritical:r[9]===true||String(r[9]).toUpperCase()==='TRUE'};});return _ok_({activeBase:'СанПиН 2.3/2.4.4282-26',coverage:out,missingMandatoryEvidence:out.filter(function(x){return x.result==='MISSING_EVIDENCE';}).length},'V34_COVERAGE');}catch(e){return _failFrom_(e);}}
function v34EvaluateEvent(eventType,objectType,objectId,token){var op=null;try{op=_beginOp_(token,'journals','V34_EVENT','Evaluate compliance event',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v34SeedRules_();var rules=_v34Rows_(MC_V34.RULE).filter(function(r){return String(r[2])===String(eventType)&&String(r[11]).toUpperCase()!=='FALSE';});var created=[];rules.forEach(function(r){var existing=_v34Rows_(MC_V34.TASK).some(function(t){return String(t[1])===String(r[0])&&String(t[4])===String(objectId)&&['OPEN','IN_PROGRESS'].indexOf(String(t[8]))>=0;});if(!existing){var id='C34-'+Utilities.getUuid();var due=new Date(Date.now()+Number(r[6]||0)*60000);_v34Sheet_(MC_V34.TASK,['TaskID','RuleID','RequirementID','ObjectType','ObjectID','DueAt','Priority','OwnerRole','Status','RelatedFactID','DeviationID','CreatedAt','CreatedBy']).appendRow([id,r[0],r[1],objectType||r[3],objectId||'',due,String(r[7]||'MEDIUM'),r[10],'OPEN','','',new Date(),_mcSessionFullName_(op.session)]);created.push(id);}});_audit_(op,'V34_EVENT','COMPLIANCE_EVENT',eventType,null,{objectType:objectType,objectId:objectId,created:created.length});_endOp_(op);return _ok_({eventType:eventType,createdTasks:created},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
