/**
 * MON CHEF V49 — INVENTORY REVISION / EXCESS STOCK
 *
 * Physical inventory is a source of truth for actual stock. A revision does not
 * silently rewrite history: every variance creates an adjustment record and an
 * immutable audit/fact entry. Excess stock may be reserved and consumed by FEFO.
 */
const V49_REV={DOC:'Ревизии_V49',LINE:'Ревизии_Строки_V49',ADJ:'Ревизии_Корректировки_V49',AUDIT:'Ревизии_Аудит_V49'};
const V49_H={
 DOC:['RevisionID','DateTime','Type','Status','Responsible','Scope','Notes','CreatedAt','CompletedAt'],
 LINE:['LineID','RevisionID','Product','BatchID','Unit','SystemQty','CountedQty','VarianceQty','VarianceType','Expiry','LocationID','Condition','Reason','Status','CreatedAt','ProcessedAt','CreatedBy'],
 ADJ:['AdjustmentID','RevisionID','LineID','BatchID','Product','Unit','BeforeQty','AfterQty','DeltaQty','AdjustmentType','NewBatchID','FactID','CreatedAt','CreatedBy','Reason'],
 AUDIT:['AuditID','DateTime','Action','RevisionID','LineID','BatchID','Product','Result','Message','Actor']
};
function _v49Sheet_(name,h){var sh=_book_().getSheetByName(name);if(!sh){sh=_book_().insertSheet(name);sh.appendRow(h);sh.setFrozenRows(1);}return sh;}
function _v49Rows_(name,h){var sh=_v49Sheet_(name,h),v=sh.getDataRange().getValues(),out=[];for(var i=1;i<v.length;i++){var o={};h.forEach(function(k,j){o[k]=v[i][j];});out.push(o);}return out;}
function _v49Id_(p){return 'V49-'+p+'-'+Utilities.getUuid().slice(0,8).toUpperCase();}
function _v49Num_(x){var n=Number(x);return isFinite(n)?n:0;}
function _v49Norm_(x){return _cleanProdName_(x).toLowerCase().replace(/ё/g,'е').replace(/\s+/g,' ');}
function _v49Audit_(action,rev,line,batch,product,result,msg,actor){_v49Sheet_(V49_REV.AUDIT,V49_H.AUDIT).appendRow([_v49Id_('AUD'),new Date(),action,rev||'',line||'',batch||'',product||'',result||'',msg||'',actor||'SYSTEM']);}
function setupV49InventoryRevision(){Object.keys(V49_H).forEach(function(k){_v49Sheet_(V49_REV[k],V49_H[k]);});try{setupV48DeficitEngine();}catch(e){}return{ok:true,sheets:V49_REV};}
function v49CreateRevision(p,token){setupV49InventoryRevision();p=p||{};var id=_v49Id_('REV');_v49Sheet_(V49_REV.DOC,V49_H.DOC).appendRow([id,new Date(),String(p.type||'FULL'),String(p.status||'OPEN'),String(p.responsible||''),String(p.scope||'ALL'),String(p.notes||''),new Date(),'']);return{ok:true,revisionId:id};}
function _v49StockRows_(){var sh=_stockBatchesSheet_(),v=sh.getDataRange().getValues(),out=[];for(var i=1;i<v.length;i++){if(!v[i][0])continue;out.push({row:i+2,id:String(v[i][0]),product:String(v[i][1]||''),unit:String(v[i][2]||''),qty:_v49Num_(v[i][9]),expiry:v[i][5]||'',location:v[i][14]||'',status:String(v[i][10]||'active'),sheet:sh});}return out;}
function v49GetRevisionCandidates(revisionId,product,token){setupV49InventoryRevision();var key=_v49Norm_(product||''),rows=_v49StockRows_().filter(function(x){return x.status==='active'&&x.qty>0&&(!key||_v49Norm_(x.product)===key);});return{ok:true,revisionId:revisionId||'',rows:rows.map(function(x){return{batchId:x.id,product:x.product,unit:x.unit,systemQty:x.qty,expiry:x.expiry,locationId:x.location};})};}
function v49AddRevisionLine(p,token){setupV49InventoryRevision();p=p||{};if(!p.revisionId||!p.product)throw new Error('revisionId и product обязательны');var batchId=String(p.batchId||'');var s=_v49StockRows_().find(function(x){return x.id===batchId;});var system=s?s.qty:_v49Num_(p.systemQty);var hasCounted=p.countedQty!==''&&p.countedQty!==null&&p.countedQty!==undefined;var counted=hasCounted?_v49Num_(p.countedQty):'';var variance=hasCounted?Math.round((counted-system)*1000)/1000:'';var type=hasCounted?(variance>0?'EXCESS':variance<0?'SHORTAGE':'MATCH'):'COUNT_REQUIRED';var lineId=_v49Id_('LINE');_v49Sheet_(V49_REV.LINE,V49_H.LINE).appendRow([lineId,p.revisionId,String(p.product),batchId,s?s.unit:String(p.unit||''),system,counted,variance,type,s?s.expiry:(p.expiry||''),s?s.location:String(p.locationId||''),String(p.condition||'OK'),String(p.reason||''),hasCounted?'OPEN':'COUNT_REQUIRED',new Date(),'','']);_v49Audit_('LINE_CREATED',p.revisionId,lineId,batchId,p.product,'OK',hasCounted?'Ревизионная строка создана':'Строка ожидает фактический пересчёт','');return{ok:true,lineId:lineId,variance:variance,varianceType:type};}
function v49SeedRevisionFromStock(revisionId,token){setupV49InventoryRevision();if(!revisionId)throw new Error('revisionId обязателен');var existing=_v49Rows_(V49_REV.LINE,V49_H.LINE).filter(function(x){return String(x.RevisionID)===String(revisionId);});var seen={};existing.forEach(function(x){seen[String(x.BatchID)+'|'+String(x.Product)]=1;});var rows=_v49StockRows_().filter(function(x){return x.status==='active'&&x.qty>0;}),created=0;rows.forEach(function(x){var key=x.id+'|'+x.product;if(seen[key])return;v49AddRevisionLine({revisionId:revisionId,product:x.product,batchId:x.id,unit:x.unit,systemQty:x.qty,countedQty:'',expiry:x.expiry,locationId:x.location,condition:'OK',reason:'Автоматически из текущего склада'},token);created++;});return{ok:true,revisionId:revisionId,created:created,total:rows.length};}

function _v49FindLine_(lineId){var sh=_v49Sheet_(V49_REV.LINE,V49_H.LINE),v=sh.getDataRange().getValues();for(var i=1;i<v.length;i++)if(String(v[i][0])===String(lineId))return{row:i+1,values:v[i],sheet:sh};return null;}
function _v49CreateFoundBatch_(line){var expiry=line.Expiry||'';if(!expiry)throw new Error('Для найденного излишка без партии укажите срок годности. Автоматически придумывать срок система не будет.');var extra={manufactured:new Date(),supplierBatch:'REVISION:'+line.RevisionID,docRef:'Ревизия '+line.RevisionID};return _createBatch_(line.Product,line.Unit,line.CountedQty,new Date(),expiry,0,'REVISION_FOUND',extra);}
function _v49SetBatchQty_(batchId,newQty){var sh=_stockBatchesSheet_(),v=sh.getDataRange().getValues();for(var i=1;i<v.length;i++)if(String(v[i][0])===String(batchId)){var before=_v49Num_(v[i][9]),used=_v49Num_(v[i][8]),qty=Math.max(0,Math.round(newQty*1000)/1000);sh.getRange(i+1,10).setValue(qty);sh.getRange(i+1,11).setValue(qty<=0.001?'consumed':'active');return{before:before,after:qty,delta:qty-before,product:v[i][1],unit:v[i][2]};}throw new Error('Партия не найдена: '+batchId);}
function v49PostRevisionLine(lineId,token){setupV49InventoryRevision();var l=_v49FindLine_(lineId);if(!l)throw new Error('Строка ревизии не найдена');var h=V49_H.LINE,row=l.values;var status=String(row[h.indexOf('Status')]);if(status==='POSTED')return{ok:true,idempotent:true,lineId:lineId};var revisionId=row[h.indexOf('RevisionID')],product=String(row[h.indexOf('Product')]),batchId=String(row[h.indexOf('BatchID')]),rawCounted=row[h.indexOf('CountedQty')];if(rawCounted===''||rawCounted===null||rawCounted===undefined)throw new Error('Сначала внесите фактическое количество');var counted=_v49Num_(rawCounted),variance=Math.round((counted-_v49Num_(row[h.indexOf('SystemQty')]))*1000)/1000,type=variance>0?'EXCESS':variance<0?'SHORTAGE':'MATCH',newBatchId='',before=0,after=0,delta=variance,factId='';try{_requireAuth_(token,'stock');}catch(e){throw e;}
  if(type==='MATCH'){l.sheet.getRange(l.row,h.indexOf('Status')+1).setValue('POSTED');l.sheet.getRange(l.row,h.indexOf('ProcessedAt')+1).setValue(new Date());_v49Audit_('POST_MATCH',revisionId,lineId,batchId,product,'OK','Остаток совпал','');return{ok:true,lineId:lineId,type:type,delta:0};}
  if(type==='EXCESS'){
    if(batchId){var r=_v49SetBatchQty_(batchId,counted);before=r.before;after=r.after;delta=r.delta;}
    else {newBatchId=_v49CreateFoundBatch_({RevisionID:revisionId,Product:product,Unit:String(row[h.indexOf('Unit')]),CountedQty:counted,Expiry:row[h.indexOf('Expiry')]});before=0;after=counted;delta=counted;batchId=newBatchId;var foundLoc=String(row[h.indexOf('LocationID')]||'');if(foundLoc&&typeof assignBatchStorage==='function'){try{assignBatchStorage(newBatchId,foundLoc,token);}catch(ignoreLoc){}}}
  } else if(type==='SHORTAGE') {if(!batchId)throw new Error('Недостачу нужно привязать к конкретной партии');var r2=_v49SetBatchQty_(batchId,counted);before=r2.before;after=r2.after;delta=r2.delta;}
  try{factId=_mcCreateFactInternal_({factType:'INVENTORY_REVISION',objectType:'BATCH',objectId:batchId||newBatchId,operationType:type,dateTime:new Date(),value:delta,unit:String(row[h.indexOf('Unit')]),result:'RECORDED',source:'INVENTORY_REVISION',batchId:batchId||newBatchId,description:'Ревизия '+revisionId+' '+type+' '+product});}catch(eFact){factId='';}if(factId&&typeof factId==='object')factId=factId.factId||factId.id||'';
  _v49Sheet_(V49_REV.ADJ,V49_H.ADJ).appendRow([_v49Id_('ADJ'),revisionId,lineId,batchId||'',product,String(row[h.indexOf('Unit')]),before,after,delta,type,newBatchId,factId,new Date(),(function(){try{var ss=_getSession_(token);return ss?String(ss.name||ss.user_id||''):'SYSTEM';}catch(e){return 'SYSTEM';}})(),String(row[h.indexOf('Reason')]||'')]);l.sheet.getRange(l.row,h.indexOf('Status')+1).setValue('POSTED');l.sheet.getRange(l.row,h.indexOf('ProcessedAt')+1).setValue(new Date());l.sheet.getRange(l.row,h.indexOf('BatchID')+1).setValue(batchId||newBatchId);_v49Audit_('POST_'+type,revisionId,lineId,batchId||newBatchId,product,'OK','Корректировка '+before+' → '+after,'');return{ok:true,lineId:lineId,type:type,before:before,after:after,delta:delta,batchId:batchId||newBatchId,factId:factId};}
// Единый интерфейс: факт пересчёта вносится в строку листа пересчёта (строка остаётся привязанной к своей партии).
function v49CountRevisionLine(lineId,countedQty,reason,token){setupV49InventoryRevision();if(countedQty===''||countedQty===null||countedQty===undefined||!isFinite(Number(countedQty)))throw new Error('Укажите фактическое количество');if(Number(countedQty)<0)throw new Error('Фактическое количество не может быть отрицательным');return _withLock_(function(){var l=_v49FindLine_(lineId);if(!l)throw new Error('Строка ревизии не найдена');var h=V49_H.LINE,row=l.values;if(String(row[h.indexOf('Status')])==='POSTED')throw new Error('Строка уже проведена');var counted=Math.round(_v49Num_(countedQty)*1000)/1000,variance=Math.round((counted-_v49Num_(row[h.indexOf('SystemQty')]))*1000)/1000,type=variance>0?'EXCESS':variance<0?'SHORTAGE':'MATCH';var c0=h.indexOf('CountedQty')+1;l.sheet.getRange(l.row,c0,1,3).setValues([[counted,variance,type]]);if(reason)l.sheet.getRange(l.row,h.indexOf('Reason')+1).setValue(String(reason));l.sheet.getRange(l.row,h.indexOf('Status')+1).setValue('OPEN');_v49Audit_('LINE_COUNTED',row[h.indexOf('RevisionID')],lineId,row[h.indexOf('BatchID')],row[h.indexOf('Product')],'OK','Факт '+counted+' (в системе '+row[h.indexOf('SystemQty')]+')',(function(){try{var ss=_getSession_(token);return ss?String(ss.name||ss.user_id||''):'';}catch(e){return '';}})());return{ok:true,lineId:lineId,countedQty:counted,variance:variance,varianceType:type};});}
function v49CompleteRevision(revisionId,token){setupV49InventoryRevision();var lines=_v49Rows_(V49_REV.LINE,V49_H.LINE).filter(function(x){return String(x.RevisionID)===String(revisionId);});var open=lines.filter(function(x){return String(x.Status)!=='POSTED';});if(open.length)throw new Error('Ревизию нельзя закрыть: есть непроведённые строки: '+open.length);var sh=_v49Sheet_(V49_REV.DOC,V49_H.DOC),v=sh.getDataRange().getValues();for(var i=1;i<v.length;i++)if(String(v[i][0])===String(revisionId)){sh.getRange(i+1,4).setValue('COMPLETED');sh.getRange(i+1,9).setValue(new Date());break;}try{v48AutomationTick('', '', token);}catch(e){}return{ok:true,revisionId:revisionId,status:'COMPLETED',lines:lines.length};}
function v49GetDashboard(){setupV49InventoryRevision();var lines=_v49Rows_(V49_REV.LINE,V49_H.LINE),docs=_v49Rows_(V49_REV.DOC,V49_H.DOC),stock=_v49StockRows_().filter(function(x){return x.status==='active'&&x.qty>0;}),excess=lines.filter(function(x){return String(x.VarianceType)==='EXCESS'&&String(x.Status)==='OPEN';}),shortage=lines.filter(function(x){return String(x.VarianceType)==='SHORTAGE'&&String(x.Status)==='OPEN';});return{ok:true,revisions:docs.length,openRevisions:docs.filter(function(x){return String(x.Status)==='OPEN';}).length,activeStockQty:stock.reduce(function(s,x){return s+x.qty;},0),openExcess:excess.length,openShortage:shortage.length};}
function v49GetOpenLines(revisionId){setupV49InventoryRevision();return{ok:true,rows:_v49Rows_(V49_REV.LINE,V49_H.LINE).filter(function(x){return !revisionId||String(x.RevisionID)===String(revisionId);}).map(function(x){return{lineId:x.LineID,revisionId:x.RevisionID,product:x.Product,batchId:x.BatchID,unit:x.Unit,systemQty:x.SystemQty,countedQty:x.CountedQty,varianceQty:x.VarianceQty,varianceType:x.VarianceType,expiry:x.Expiry,locationId:x.LocationID,condition:x.Condition,reason:x.Reason,status:x.Status};})};}
