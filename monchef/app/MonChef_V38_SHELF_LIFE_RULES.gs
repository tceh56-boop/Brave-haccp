/** MON CHEF V38 — SHELF LIFE / REALIZATION RULE ENGINE
 * Rules are configuration, not hidden legal assumptions.
 * A rule becomes operational only after APPROVED status and a source/basis is recorded.
 */
var MC_V38={RULE:'Сроки_Правила_V38',ASSIGN:'Сроки_Назначения_V38',CALC:'Сроки_Расчёт_V38',GAP:'Сроки_Пробелы_V38'};
var MC_V38_H={
 RULE:['RuleID','Priority','FolderPattern','Category','TTK_ID','ProductPattern','Regime','StorageMinC','StorageMaxC','ShelfLifeHours','RealizationHours','FreezeAllowed','FreezeMinC','FreezeMaxC','FreezeShelfLifeHours','PackagingRequired','AfterOpenHours','SourceType','SourceRef','SourceDate','Status','Notes','CreatedAt','UpdatedAt'],
 ASSIGN:['AssignmentID','TTK_ID','ProductName','DrivePath','Category','RuleID','MatchType','Confidence','Status','Reason','CreatedAt'],
 CALC:['CalcID','TTK_ID','ProductName','BatchID','ProductionAt','Regime','RuleID','StorageMinC','StorageMaxC','FreezeMinC','FreezeMaxC','ShelfLifeHours','RealizationHours','ExpiresAt','RealizationExpiresAt','FreezeExpiresAt','Status','Warning','CreatedAt'],
 GAP:['GapID','TTK_ID','ProductName','DrivePath','GapType','Description','Severity','Status','CreatedAt']
};
function _v38Sheet_(n,h){var s=_book_().getSheetByName(n);if(!s){s=_book_().insertSheet(n);s.getRange(1,1,1,h.length).setValues([h]);s.setFrozenRows(1);}return s;}
function _v38Init_(){Object.keys(MC_V38).forEach(function(k){_v38Sheet_(MC_V38[k],MC_V38_H[k]);});}
function setupV38ShelfLife(token){try{_requireAuth_(token,'journals');_v38Init_();return _ok_({initialized:true,sheets:Object.keys(MC_V38).map(function(k){return MC_V38[k];}),message:'Правила созданы без выдуманных нормативных сроков. Их нужно утвердить с источником.'},'V38_SETUP');}catch(e){return _failFrom_(e);}}
function _v38Rows_(n){var s=_book_().getSheetByName(n);if(!s||s.getLastRow()<2)return[];return s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues();}
function _v38Norm_(s){return String(s||'').toLowerCase().replace(/ё/g,'е').replace(/[^a-zа-я0-9]+/gi,' ').replace(/\s+/g,' ').trim();}
function _v38Id_(p,k){var b=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(k||''),Utilities.Charset.UTF_8);return p+'-'+b.map(function(x){x=x<0?x+256:x;var h=x.toString(16);return h.length===1?'0'+h:h;}).join('').substring(0,16).toUpperCase();}
function _v38Bool_(x){return /^(true|1|yes|да|y)$/i.test(String(x||''));}
function _v38Match_(r,ttk){var score=0,type='NONE',folder=_v38Norm_(ttk.path),cat=_v38Norm_(ttk.category),name=_v38Norm_(ttk.name);if(String(r[4]||'')&&String(r[4])===String(ttk.id)){score=1000;type='TTK_ID';}else if(String(r[5]||'')&&name.indexOf(_v38Norm_(r[5]))>=0){score=700;type='PRODUCT_PATTERN';}else if(String(r[2]||'')&&folder.indexOf(_v38Norm_(r[2]))>=0){score=500;type='FOLDER';}else if(String(r[3]||'')&&cat===_v38Norm_(r[3])){score=300;type='CATEGORY';}else return null;if(String(r[20]||'').toUpperCase()!=='APPROVED')return null;return {score:score,type:type};}
function v38ResolveRule(ttkId,token){try{_requireAuth_(token,'journals');_v38Init_();var masters=_v36Rows_(MC_V36.MASTER),m=masters.filter(function(x){return String(x[0])===String(ttkId);})[0];if(!m)throw new Error('TTK не найден: '+ttkId);var ttk={id:m[0],name:m[8],path:m[4],category:m[5]};var best=null;_v38Rows_(MC_V38.RULE).forEach(function(r){var hit=_v38Match_(r,ttk);if(hit&&(!best||hit.score>best.score||hit.score===best.score&&Number(r[1]||0)>Number(best.r[1]||0)))best={r:r,hit:hit};});if(!best)return _ok_({ttk:ttk,rule:null,status:'NO_APPROVED_RULE',warning:'Для ТТК нет утверждённого правила срока хранения/реализации. Автоматически срок не назначается.'},'V38_RESOLVE');var r=best.r;return _ok_({ttk:ttk,rule:{id:r[0],regime:r[6],storageMinC:r[7],storageMaxC:r[8],shelfLifeHours:r[9],realizationHours:r[10],freezeAllowed:r[11],freezeMinC:r[12],freezeMaxC:r[13],freezeShelfLifeHours:r[14],packagingRequired:r[15],afterOpenHours:r[16],sourceType:r[17],sourceRef:r[18],sourceDate:r[19]},matchType:best.hit.type,score:best.hit.score,status:'OK'},'V38_RESOLVE');}catch(e){return _failFrom_(e);}}
function v38AddRule(json,token){var op=null;try{op=_beginOp_(token,'journals','V38_RULE','Create shelf-life rule',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v38Init_();var d=typeof json==='string'?JSON.parse(json||'{}'):json||{};if(!d.status)d.status='DRAFT';if(String(d.status).toUpperCase()==='APPROVED'&&(!d.sourceType||!d.sourceRef))throw new Error('Утверждённое правило обязано иметь источник/основание');var id=d.ruleId||_v38Id_('RULE',JSON.stringify(d));_book_().getSheetByName(MC_V38.RULE).appendRow([id,Number(d.priority||0),d.folderPattern||'',d.category||'',d.ttkId||'',d.productPattern||'',d.regime||'',d.storageMinC??'',d.storageMaxC??'',d.shelfLifeHours??'',d.realizationHours??'',d.freezeAllowed===undefined?'':d.freezeAllowed?'TRUE':'FALSE',d.freezeMinC??'',d.freezeMaxC??'',d.freezeShelfLifeHours??'',d.packagingRequired||'',d.afterOpenHours??'',d.sourceType||'',d.sourceRef||'',d.sourceDate||'',d.status,d.notes||'',new Date(),new Date()]);_audit_(op,'V38_RULE','SHELF_LIFE_RULE',id,null,d);_endOp_(op);return _ok_({ruleId:id},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v38Calculate(json,token){var op=null;try{op=_beginOp_(token,'journals','V38_CALC','Calculate shelf life',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v38Init_();var d=typeof json==='string'?JSON.parse(json||'{}'):json||{};if(!d.ttkId||!d.productionAt)throw new Error('ttkId и productionAt обязательны');var rr=JSON.parse(v38ResolveRule(d.ttkId,token));if(!rr.success||!rr.data||rr.data.status!=='OK')return rr;var x=rr.data, r=x.rule, prod=new Date(d.productionAt), calcId=_v38Id_('CALC',d.ttkId+'|'+prod.toISOString()+'|'+(d.batchId||''));function addHours(h){if(h===''||h===null||h===undefined||isNaN(Number(h)))return '';return new Date(prod.getTime()+Number(h)*3600000);}var exp=addHours(r.shelfLifeHours),rexp=addHours(r.realizationHours),fexp=addHours(r.freezeShelfLifeHours);var status='CALCULATED',warning='';if(!r.shelfLifeHours&& !r.realizationHours && !r.freezeShelfLifeHours){status='REVIEW';warning='Нет заданного срока. Требуется утверждённое правило.';}var row=[calcId,d.ttkId,x.ttk.name,d.batchId||'',prod,r.regime,r.id,r.storageMinC,r.storageMaxC,r.freezeMinC,r.freezeMaxC,r.shelfLifeHours,r.realizationHours,exp,rexp,fexp,status,warning,new Date()];_book_().getSheetByName(MC_V38.CALC).appendRow(row);_audit_(op,'V38_CALC','SHELF_LIFE_CALC',calcId,null,{ttkId:d.ttkId,batchId:d.batchId||'',ruleId:r.id});_endOp_(op);return _ok_({calcId:calcId,ttk:x,productionAt:prod,expiresAt:exp,realizationExpiresAt:rexp,freezeExpiresAt:fexp,status:status,warning:warning},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v38BuildGaps(token){try{_requireAuth_(token,'journals');_v38Init_();var masters=_v36Rows_(MC_V36.MASTER),rules=_v38Rows_(MC_V38.RULE),gsh=_book_().getSheetByName(MC_V38.GAP);var old=gsh.getDataRange().getValues();for(var i=old.length-1;i>=1;i--)gsh.deleteRow(i+1);var gaps=0;masters.forEach(function(m){var ttk={id:m[0],name:m[8],path:m[4],category:m[5]},matched=false;rules.forEach(function(r){if(_v38Match_(r,ttk))matched=true;});if(!matched){gsh.appendRow([_v38Id_('GAP',ttk.id),ttk.id,ttk.name,ttk.path,'NO_APPROVED_RULE','Нет утверждённого правила срока хранения/реализации для этой ТТК/папки.','HIGH','OPEN',new Date()]);gaps++;}});return _ok_({checked:masters.length,gaps:gaps},'V38_GAPS');}catch(e){return _failFrom_(e);}}
function v38GetDashboard(token){try{_requireAuth_(token,'journals');_v38Init_();var r=_v38Rows_(MC_V38.RULE),a=_v38Rows_(MC_V38.ASSIGN),c=_v38Rows_(MC_V38.CALC),g=_v38Rows_(MC_V38.GAP);return _ok_({rules:r,ruleCount:r.length,approvedRules:r.filter(function(x){return String(x[20]).toUpperCase()==='APPROVED';}).length,calculations:c.length,openGaps:g.filter(function(x){return String(x[7]).toUpperCase()==='OPEN';}).length,assignments:a.length},'V38_DASH');}catch(e){return _failFrom_(e);}}
