/**
 * MON CHEF V37 — TTK -> PPK/HACCP BRIDGE
 *
 * Purpose: build a document-scoped PPK/HACCP working model from the real TTK graph.
 * Important: this module NEVER invents hazards, CCPs, critical limits or monitoring values.
 * It creates the technological process map and explicit gaps requiring expert approval.
 */
var MC_V37={DOC:'ППК_Master_V37',TTK:'ППК_ТТК_V37',PROC:'ППК_Процессы_V37',GAP:'ППК_Пробелы_V37',CONTROL:'ППК_Контроли_V37',VERIFY:'ППК_Верификация_V37'};
var MC_V37_H={
 DOC:['DocumentID','Name','Version','Status','DateFrom','DateTo','Responsible','CreatedAt','CreatedBy','TTKSetHash','Source','ApprovedAt','ApprovedBy'],
 TTK:['DocumentID','TTK_ID','ProductName','Role','Depth','ParentTTK_ID','Sequence','SourceStatus','LinkStatus'],
 PROC:['DocumentID','ProcessID','TTK_ID','StepNo','OperationText','Area','Equipment','Input','Output','Applicable','Source','Status'],
 GAP:['GapID','DocumentID','Category','ObjectType','ObjectID','TTK_ID','Description','Severity','Blocking','Status','CreatedAt'],
 CONTROL:['DocumentID','ControlID','ProcessID','Type','ControlMeasure','CriticalLimit','Unit','MonitoringMethod','Frequency','ResponsibleRole','CorrectiveAction','VerificationMethod','SourceRequirement','Status'],
 VERIFY:['VerificationID','DocumentID','ControlID','Method','Frequency','Responsible','Result','EvidenceID','PerformedAt','Status','Notes']
};
function _v37Sheet_(n,h){var s=_book_().getSheetByName(n);if(!s){s=_book_().insertSheet(n);s.getRange(1,1,1,h.length).setValues([h]);s.setFrozenRows(1);}return s;}
function _v37Init_(){Object.keys(MC_V37).forEach(function(k){_v37Sheet_(MC_V37[k],MC_V37_H[k]);});}
function _v37Rows_(n){var s=_book_().getSheetByName(n);if(!s||s.getLastRow()<2)return[];return s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues();}
function _v37Norm_(s){return String(s||'').toLowerCase().replace(/ё/g,'е').replace(/[^a-zа-я0-9]+/gi,' ').replace(/\s+/g,' ').trim();}
function _v37Hash_(s){var b=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s||''),Utilities.Charset.UTF_8);return b.map(function(x){x=x<0?x+256:x;var h=x.toString(16);return h.length===1?'0'+h:h;}).join('');}
function _v37Id_(p,k){return p+'-'+_v37Hash_(k).substring(0,16).toUpperCase();}
function setupV37TtkPpk(token){try{_requireAuth_(token,'journals');_v37Init_();return _ok_({initialized:true,sheets:Object.keys(MC_V37).map(function(k){return MC_V37[k];})},'V37_SETUP');}catch(e){return _failFrom_(e);}}
function _v37MasterMap_(){var m={};_v36Rows_(MC_V36.MASTER).forEach(function(r){m[String(r[0])]={id:r[0],name:r[8],status:r[17],file:r[1],url:r[2]};});return m;}
function _v37LinkMap_(){var by={};_v36Rows_(MC_V36.LINK).forEach(function(r){var p=String(r[1]),c=String(r[2]);if(!by[p])by[p]=[];by[p].push({child:c,name:r[3],qty:r[5],unit:r[6],status:r[9]});});return by;}
function _v37Closure_(roots){var map=_v37MasterMap_(),links=_v37LinkMap_(),seen={},out=[];function walk(id,depth,parent,seq){if(!id||seen[id])return;seen[id]=true;var m=map[id];if(!m)return;out.push({id:id,name:m.name,status:m.status,depth:depth,parent:parent||'',sequence:seq||0});(links[id]||[]).forEach(function(x,i){walk(x.child,depth+1,id,i+1);});}roots.forEach(function(id,i){walk(String(id),0,'',i+1);});return out;}
function v37CreateFromTtk(json,token){var op=null;try{op=_beginOp_(token,'journals','V37_PPK_FROM_TTK','Build PPK from TTK graph',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v37Init_();_v36Init_();var d=typeof json==='string'?JSON.parse(json||'{}'):json||{};var roots=(d.ttkIds||[]).map(String).filter(Boolean);if(!roots.length)throw new Error('Нужно передать ttkIds');var closure=_v37Closure_(roots);if(!closure.length)throw new Error('Указанные ТТК не найдены в ТТК_Master_V36');var docId=d.documentId||'PPK37-'+Utilities.getUuid();var now=new Date();var names=closure.map(function(x){return x.name;}).join(' + ');var setHash=_v37Hash_(closure.map(function(x){return x.id;}).sort().join('|'));_v37Sheet_(MC_V37.DOC,MC_V37_H.DOC).appendRow([docId,d.name||('ППК / ХАССП — '+names.substring(0,180)),d.version||'1.0','DRAFT',d.dateFrom||'',d.dateTo||'',d.responsible||_mcSessionFullName_(op.session),now,_mcSessionFullName_(op.session),setHash,'TTK_MASTER_V36','','']);var tsh=_book_().getSheetByName(MC_V37.TTK);var psh=_book_().getSheetByName(MC_V37.PROC);var gsh=_book_().getSheetByName(MC_V37.GAP);var links=_v37LinkMap_();closure.forEach(function(x){tsh.appendRow([docId,x.id,x.name,x.depth===0?'ROOT':'DEPENDENCY',x.depth,x.parent,x.sequence,x.status,(links[x.id]||[]).every(function(z){return z.status==='APPROVED';})?'APPROVED':'REVIEW']);var procs=_v36Rows_(MC_V36.PROC).filter(function(p){return String(p[0])===String(x.id);});procs.forEach(function(p){var pid=_v37Id_('PROC',docId+'|'+x.id+'|'+p[1]);psh.appendRow([docId,pid,x.id,p[1],p[2],p[3],p[4],p[5],p[6],true,'TTK_MASTER_V36','DRAFT']);gsh.appendRow([_v37Id_('GAP',docId+'|HAZ|'+pid),docId,'HAZARD_ANALYSIS','PROCESS',pid,x.id,'Анализ опасностей не заполнен: эксперт должен определить биологические/химические/физические опасности и обоснование.','HIGH',true,'OPEN',now]);gsh.appendRow([_v37Id_('GAP',docId+'|CTRL|'+pid),docId,'CONTROL_DEFINITION','PROCESS',pid,x.id,'Не определены меры контроля/CCP/OPRP и их источник. Система не подставляет нормативные пределы автоматически.','HIGH',true,'OPEN',now]);});if(!procs.length)gsh.appendRow([_v37Id_('GAP',docId+'|TECH|'+x.id),docId,'TECHNOLOGY_DATA','TTK',x.id,x.id,'В ТТК нет распознанных технологических операций; проверить оригинальный документ и импорт.','HIGH',true,'OPEN',now]);});_audit_(op,'V37_PPK_FROM_TTK','PPK_DOCUMENT',docId,null,{ttkRoots:roots,ttkCount:closure.length});_endOp_(op);return _ok_({documentId:docId,status:'DRAFT',ttkCount:closure.length,processCount:_v37Rows_(MC_V37.PROC).filter(function(x){return String(x[0])===docId;}).length,gaps:_v37Rows_(MC_V37.GAP).filter(function(x){return String(x[1])===docId;}).length},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v37GetDocument(documentId,token){try{_requireAuth_(token,'journals');_v37Init_();var d=_v37Rows_(MC_V37.DOC).filter(function(x){return String(x[0])===String(documentId);})[0];if(!d)throw new Error('Документ не найден');return _ok_({document:d,ttk:_v37Rows_(MC_V37.TTK).filter(function(x){return String(x[0])===String(documentId);}),processes:_v37Rows_(MC_V37.PROC).filter(function(x){return String(x[0])===String(documentId);}),controls:_v37Rows_(MC_V37.CONTROL).filter(function(x){return String(x[0])===String(documentId);}),verification:_v37Rows_(MC_V37.VERIFY).filter(function(x){return String(x[1])===String(documentId);}),gaps:_v37Rows_(MC_V37.GAP).filter(function(x){return String(x[1])===String(documentId)&&String(x[9]).toUpperCase()==='OPEN';})},'V37_DOC');}catch(e){return _failFrom_(e);}}
function v37AddControl(json,token){var op=null;try{op=_beginOp_(token,'journals','V37_CONTROL','Add scoped HACCP control',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v37Init_();var d=typeof json==='string'?JSON.parse(json||'{}'):json||{};if(!d.documentId||!d.processId||!d.type||!d.controlMeasure)throw new Error('documentId, processId, type и controlMeasure обязательны');var id=d.controlId||_v37Id_('CTRL',d.documentId+'|'+d.processId+'|'+Utilities.getUuid());_v37Sheet_(MC_V37.CONTROL,MC_V37_H.CONTROL).appendRow([d.documentId,id,d.processId,d.type,d.controlMeasure,d.criticalLimit||'',d.unit||'',d.monitoringMethod||'',d.frequency||'',d.responsibleRole||'',d.correctiveAction||'',d.verificationMethod||'',d.sourceRequirement||'',d.status||'DRAFT']);_audit_(op,'V37_CONTROL','PPK_CONTROL',id,null,{documentId:d.documentId,processId:d.processId});_endOp_(op);return _ok_({controlId:id},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v37Validate(documentId,token){try{_requireAuth_(token,'journals');_v37Init_();var d=_v37Rows_(MC_V37.DOC).filter(function(x){return String(x[0])===String(documentId);})[0];if(!d)throw new Error('Документ не найден');var ps=_v37Rows_(MC_V37.PROC).filter(function(x){return String(x[0])===String(documentId)&&String(x[9]).toUpperCase()!=='FALSE';});var cs=_v37Rows_(MC_V37.CONTROL).filter(function(x){return String(x[0])===String(documentId)&&String(x[13]).toUpperCase()!=='ARCHIVED';});var gaps=_v37Rows_(MC_V37.GAP).filter(function(x){return String(x[1])===String(documentId)&&String(x[9]).toUpperCase()==='OPEN';});var structural=[];ps.forEach(function(p){var controls=cs.filter(function(c){return String(c[2])===String(p[1]);});if(!controls.length)structural.push({category:'CONTROL_DEFINITION',objectId:p[1],description:'Нет контроля/CCP/OPRP для процесса'});controls.forEach(function(c){if(!String(c[5]||'').trim())structural.push({category:'CRITICAL_LIMIT',objectId:c[1],description:'Не указан критический предел; значение не генерируется системой'});if(!String(c[7]||'').trim())structural.push({category:'MONITORING_METHOD',objectId:c[1],description:'Не указан метод мониторинга'});if(!String(c[10]||'').trim())structural.push({category:'CORRECTIVE_ACTION',objectId:c[1],description:'Не указано корректирующее действие'});if(!String(c[12]||'').trim())structural.push({category:'SOURCE_REQUIREMENT',objectId:c[1],description:'Не указан источник/основание контрольного требования'});});});return _ok_({documentId:documentId,processCount:ps.length,controlCount:cs.length,openGaps:gaps.length,structuralGaps:structural,valid:gaps.length===0&&structural.length===0&&ps.length>0},'V37_VALIDATE');}catch(e){return _failFrom_(e);}}
function v37Approve(documentId,token){var op=null;try{op=_beginOp_(token,'journals','V37_APPROVE','Approve scoped PPK',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){var r=JSON.parse(v37Validate(documentId,token));if(!r.success||!r.data||!r.data.valid)throw new Error('Нельзя активировать ППК: есть незакрытые пробелы или не заполнены обязательные поля');var sh=_book_().getSheetByName(MC_V37.DOC),rows=sh.getDataRange().getValues(),row=-1;for(var i=1;i<rows.length;i++)if(String(rows[i][0])===String(documentId)){row=i+1;break;}if(row<0)throw new Error('Документ не найден');sh.getRange(row,4).setValue('ACTIVE');sh.getRange(row,12).setValue(new Date());sh.getRange(row,13).setValue(_mcSessionFullName_(op.session));_audit_(op,'V37_APPROVE','PPK_DOCUMENT',documentId,null,{status:'ACTIVE'});_endOp_(op);return _ok_({documentId:documentId,status:'ACTIVE'},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v37GetDashboard(token){try{_requireAuth_(token,'journals');_v37Init_();var d=_v37Rows_(MC_V37.DOC),p=_v37Rows_(MC_V37.PROC),c=_v37Rows_(MC_V37.CONTROL),g=_v37Rows_(MC_V37.GAP);return _ok_({documents:d,documentCount:d.length,processCount:p.length,controlCount:c.length,openGapCount:g.filter(function(x){return String(x[9]).toUpperCase()==='OPEN';}).length},'V37_DASH');}catch(e){return _failFrom_(e);}}
