/** MON CHEF V46 — Production output allocation to multiple banquets.
 * One production order / batch can serve multiple banquet demands.
 * Allocation is planning/reservation/issue; production remains V27 source of truth.
 */
const V46_ALLOC = { ALLOC:'Производство_Распределение_V46', AUDIT:'Производство_Распределение_Аудит_V46' };
const V46_HEADERS = {
  ALLOC:['AllocationID','ProductionID','BatchID','BanquetID','BanquetDate','DishCode','ProductName','PlannedQty','ReservedQty','IssuedQty','Unit','Status','CreatedAt','UpdatedAt','Source','Notes'],
  AUDIT:['AuditID','AllocationID','ProductionID','BanquetID','Action','At','EmployeeID','Qty','BeforeStatus','AfterStatus','Result','Message']
};
function _v46Sheet_(name,headers){var ss=_book_(),sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.appendRow(headers);sh.setFrozenRows(1);}return sh;}
function _v46Rows_(name){var sh=_book_().getSheetByName(name);if(!sh||sh.getLastRow()<2)return[];var v=sh.getDataRange().getValues(),h=v[0];return v.slice(1).filter(function(r){return r.some(function(x){return x!=='';});}).map(function(r){var o={};h.forEach(function(k,i){o[k]=r[i];});return o;});}
function _v46Id_(p){return 'V46-'+p+'-'+Utilities.getUuid().slice(0,8).toUpperCase();}
function setupV46BanquetAllocation(){Object.keys(V46_HEADERS).forEach(function(k){_v46Sheet_(V46_ALLOC[k],V46_HEADERS[k]);});if(typeof setupV45ProductionBridge==='function')setupV45ProductionBridge();return{ok:true,sheets:V46_ALLOC};}
function _v46Production_(id){if(typeof _v45ProductionRows_==='function'){var r=_v45ProductionRows_().find(function(x){return String(x.id)===String(id);});if(r)return r;}var f=_findProduction_(_productionSheet_(),id);if(!f)throw new Error('Производственное задание не найдено: '+id);return{id:String(id),name:String(f.data[2]||''),code:String(f.data[3]||''),planned:Number(f.data[5])||0,actual:f.data[6]===''?null:Number(f.data[6]),unit:String(f.data[7]||''),batch:String(f.data[14]||''),status:String(f.data[12]||'')};}
function _v46ExistingForProd_(pid){return _v46Rows_(V46_ALLOC.ALLOC).filter(function(x){return String(x.ProductionID)===String(pid);});}
function _v46Audit_(a,p,b,action,emp,qty,bs,as,result,msg){_v46Sheet_(V46_ALLOC.AUDIT,V46_HEADERS.AUDIT).appendRow([_v46Id_('AUD'),a||'',p||'',b||'',action,new Date(),emp||'',qty==null?'':qty,bs||'',as||'',result||'',msg||'']);}
function _v46Status_(r){var p=Number(r.PlannedQty)||0,rs=Number(r.ReservedQty)||0,is=Number(r.IssuedQty)||0;if(is>=p-0.0001)return'ISSUED';if(rs>0||is>0)return'RESERVED';return'PLANNED';}
function v46CreateAllocation(p,token){
  setupV46BanquetAllocation();p=p||{};var pid=String(p.productionId||''),bid=String(p.banquetId||'');if(!pid||!bid)throw new Error('Нужны productionId и banquetId');var prod=_v46Production_(pid);if(['PLANNED','IN_PROGRESS','COMPLETED'].indexOf(prod.status)<0)throw new Error('Производство нельзя распределять в статусе '+prod.status);
  var q=Number(String(p.qty||'').replace(',','.'));if(!(q>0))throw new Error('Количество распределения должно быть больше нуля');var existing=_v46ExistingForProd_(pid),reserved=existing.reduce(function(s,x){return s+(Number(x.ReservedQty)||0);},0),issued=existing.reduce(function(s,x){return s+(Number(x.IssuedQty)||0);},0),availablePlan=Math.max(0,prod.planned-reserved);
  if(q>availablePlan+0.0001)throw new Error('Распределение превышает ещё не распределённый план: '+availablePlan+' '+prod.unit);
  var row={AllocationID:_v46Id_('ALLOC'),ProductionID:pid,BatchID:prod.batch||'',BanquetID:bid,BanquetDate:p.banquetDate||'',DishCode:prod.code,ProductName:prod.name,PlannedQty:q,ReservedQty:q,IssuedQty:0,Unit:prod.unit,Status:'RESERVED',CreatedAt:new Date(),UpdatedAt:new Date(),Source:p.source||'V46',Notes:p.notes||''};
  _v46Sheet_(V46_ALLOC.ALLOC,V46_HEADERS.ALLOC).appendRow(V46_HEADERS.ALLOC.map(function(k){return row[k]===undefined?'':row[k];}));_v46Audit_(row.AllocationID,pid,bid,'CREATE',p.employee||'',q,'','RESERVED','OK','Создан резерв банкетного распределения');return{ok:true,allocation:row,unallocatedPlan:Math.max(0,prod.planned-reserved-q),production:prod};
}
function v46SeedFromProduction(pids,token){setupV46BanquetAllocation();var ids=Array.isArray(pids)?pids:[];if(!ids.length)ids=_v45ProductionRows_().map(function(x){return x.id;});var created=0,skipped=0;ids.forEach(function(pid){var p=_v46Production_(pid),raw=p.alloc||'[]',a=[];try{a=JSON.parse(raw||'[]');}catch(e){a=[];}a.forEach(function(x){var bid=String(x.eventId||x.banquetId||'');var q=Number(x.qty)||0;if(!bid||!(q>0))return;var exists=_v46ExistingForProd_(pid).some(function(r){return String(r.BanquetID)===bid&&Math.abs((Number(r.PlannedQty)||0)-q)<0.0001;});if(exists){skipped++;return;}try{v46CreateAllocation({productionId:pid,banquetId:bid,banquetDate:x.date||'',qty:q,source:'V25_ALLOCATION',notes:(x.dishName||'')+' / '+(x.dishCode||'')},token);created++;}catch(e){skipped++;}});});return{ok:true,created:created,skipped:skipped};}
function v46ReserveAllocation(allocationId,qty,token){setupV46BanquetAllocation();var rows=_v46Rows_(V46_ALLOC.ALLOC),r=rows.find(function(x){return String(x.AllocationID)===String(allocationId);});if(!r)throw new Error('Распределение не найдено');var q=Number(qty);if(!(q>0))q=Number(r.PlannedQty)||0;var prod=_v46Production_(r.ProductionID),current=Number(r.ReservedQty)||0,issued=Number(r.IssuedQty)||0,other=_v46ExistingForProd_(r.ProductionID).filter(function(x){return String(x.AllocationID)!==String(allocationId);}).reduce(function(s,x){return s+(Number(x.ReservedQty)||0);},0);if(q<issued-0.0001)throw new Error('Резерв меньше уже выданного');if(q>Number(r.PlannedQty)+0.0001)throw new Error('Резерв больше плана распределения');if(other+q>prod.planned+0.0001)throw new Error('Общий резерв превышает производственный план');var sh=_v46Sheet_(V46_ALLOC.ALLOC,V46_HEADERS.ALLOC),v=sh.getDataRange().getValues(),ri=-1;for(var i=1;i<v.length;i++)if(String(v[i][0])===String(allocationId)){ri=i+1;break;}if(ri<0)throw new Error('Строка распределения не найдена');var st=_v46Status_({PlannedQty:r.PlannedQty,ReservedQty:q,IssuedQty:issued});sh.getRange(ri,V46_HEADERS.ALLOC.indexOf('ReservedQty')+1).setValue(q);sh.getRange(ri,V46_HEADERS.ALLOC.indexOf('Status')+1).setValue(st);sh.getRange(ri,V46_HEADERS.ALLOC.indexOf('UpdatedAt')+1).setValue(new Date());_v46Audit_(allocationId,r.ProductionID,r.BanquetID,'RESERVE','',q,r.Status,st,'OK','Резерв обновлён');return{ok:true,allocationId:allocationId,reserved:q,status:st};}
function v46IssueAllocation(allocationId,qty,token,employee){
  setupV46BanquetAllocation();var rows=_v46Rows_(V46_ALLOC.ALLOC),r=rows.find(function(x){return String(x.AllocationID)===String(allocationId);});if(!r)throw new Error('Распределение не найдено');var prod=_v46Production_(r.ProductionID);if(prod.status!=='COMPLETED')throw new Error('Нельзя выдавать распределение: производство не завершено');var q=Number(qty);if(!(q>0))throw new Error('Количество выдачи должно быть больше нуля');var issued=Number(r.IssuedQty)||0,reserved=Number(r.ReservedQty)||0;if(issued+q>reserved+0.0001)throw new Error('Выдача превышает резерв: доступно '+(reserved-issued));var batch=String(r.BatchID||prod.batch||'');if(!batch)throw new Error('У выпуска нет партии для адресной выдачи');var c=_consumeSpecificBatch_(batch,q);if(!c||c.taken+0.0001<q)throw new Error('Недостаточно остатка в партии '+batch);
  var sh=_v46Sheet_(V46_ALLOC.ALLOC,V46_HEADERS.ALLOC),v=sh.getDataRange().getValues(),ri=-1;for(var i=1;i<v.length;i++)if(String(v[i][0])===String(allocationId)){ri=i+1;break;}if(ri<0)throw new Error('Строка распределения не найдена');var ni=issued+q,st=ni>=Number(r.PlannedQty)-0.0001?'ISSUED':'PARTIAL';sh.getRange(ri,V46_HEADERS.ALLOC.indexOf('IssuedQty')+1).setValue(ni);sh.getRange(ri,V46_HEADERS.ALLOC.indexOf('Status')+1).setValue(st);sh.getRange(ri,V46_HEADERS.ALLOC.indexOf('UpdatedAt')+1).setValue(new Date());
  try{var issue=_mcV28Sheet_();issue.appendRow([_v46Id_('ISS'),r.BanquetID,r.BanquetDate,'',r.DishCode,r.ProductName,r.PlannedQty,q,r.Unit,batch,new Date(),employee||'','ISSUED','', 'V46 allocation']);}catch(e){}
  try{if(typeof _mcCreateTraceLink_==='function')_mcCreateTraceLink_('BATCH',batch,'ВЫДАНА_НА_БАНКЕТ','BANQUET',String(r.BanquetID),{dateTime:new Date(),actor:employee||'',qty:q,unit:r.Unit,allocationId:allocationId});}catch(e2){}
  try{if(typeof _mcCreateFactInternal_==='function')_mcCreateFactInternal_({factType:'BANQUET_ISSUE',objectType:'BANQUET',objectId:r.BanquetID,operationType:'ISSUE_ALLOCATED_PRODUCTION',dateTime:new Date(),value:q,unit:r.Unit,result:'RECORDED',source:'V46',employeeName:employee||'',description:'Выдача '+r.ProductName+' из партии '+batch+' на банкет '+r.BanquetID,skipRules:true},null);}catch(e3){}
  _v46Audit_(allocationId,r.ProductionID,r.BanquetID,'ISSUE',employee||'',q,r.Status,st,'OK','Адресная выдача из партии '+batch);return{ok:true,allocationId:allocationId,banquetId:r.BanquetID,issued:ni,status:st,batchId:batch,batchRemain:c.remainBefore-c.taken};
}
function v46GetProductionAllocations(productionId,token){setupV46BanquetAllocation();var p=_v46Production_(productionId),rows=_v46ExistingForProd_(productionId),reserved=rows.reduce(function(s,x){return s+(Number(x.ReservedQty)||0);},0),issued=rows.reduce(function(s,x){return s+(Number(x.IssuedQty)||0);},0);return{ok:true,production:p,allocations:rows,summary:{planned:p.planned,reserved:reserved,issued:issued,unallocated:Math.max(0,p.planned-reserved),unissued:Math.max(0,reserved-issued),productionRemainder:p.actual==null?null:Math.max(0,p.actual-issued)}};}
function v46GetBanquetAllocations(banquetId,token){setupV46BanquetAllocation();var rows=_v46Rows_(V46_ALLOC.ALLOC).filter(function(x){return String(x.BanquetID)===String(banquetId);});return{ok:true,banquetId:banquetId,allocations:rows,totalReserved:rows.reduce(function(s,x){return s+(Number(x.ReservedQty)||0);},0),totalIssued:rows.reduce(function(s,x){return s+(Number(x.IssuedQty)||0);},0)};}
function v46GetDashboard(){setupV46BanquetAllocation();var r=_v46Rows_(V46_ALLOC.ALLOC),pids={};r.forEach(function(x){pids[x.ProductionID]=1;});return{allocations:r.length,productions:Object.keys(pids).length,reserved:r.reduce(function(s,x){return s+(Number(x.ReservedQty)||0);},0),issued:r.reduce(function(s,x){return s+(Number(x.IssuedQty)||0);},0),open:r.filter(function(x){return ['RESERVED','PARTIAL'].indexOf(String(x.Status))>=0;}).length};}
