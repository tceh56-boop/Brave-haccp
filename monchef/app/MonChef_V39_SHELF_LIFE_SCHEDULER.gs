/** MON CHEF V39 — SHELF LIFE + PRODUCTION WINDOW ENGINE
 * Converts approved shelf-life rules into production constraints.
 * No normative values are invented here.
 */
var MC_V39={WINDOW:'Производство_Окна_V39',ALERT:'Производство_Сроки_Алерты_V39'};
var MC_V39_H={
 WINDOW:['WindowID','TTK_ID','ProductName','BatchID','EventID','EventAt','NeedQty','RuleID','Regime','ShelfLifeHours','RealizationHours','FreezeAllowed','FreezeShelfLifeHours','EarliestProductionAt','LatestProductionAt','FreezeLatestProductionAt','UseByAt','Status','Warning','CreatedAt'],
 ALERT:['AlertID','WindowID','Severity','Type','TTK_ID','ProductName','EventID','Message','Action','Status','CreatedAt']
};
function _v39Sheet_(n,h){var s=_book_().getSheetByName(n);if(!s){s=_book_().insertSheet(n);s.getRange(1,1,1,h.length).setValues([h]);s.setFrozenRows(1);}return s;}
function _v39Init_(){Object.keys(MC_V39).forEach(function(k){_v39Sheet_(MC_V39[k],MC_V39_H[k]);});}
function _v39Rows_(n){var s=_book_().getSheetByName(n);if(!s||s.getLastRow()<2)return[];return s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues();}
function _v39Id_(p,k){var b=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(k||''),Utilities.Charset.UTF_8);return p+'-'+b.map(function(x){x=x<0?x+256:x;var h=x.toString(16);return h.length===1?'0'+h:h;}).join('').substring(0,16).toUpperCase();}
function _v39Hours_(x){return x===''||x===null||x===undefined||isNaN(Number(x))?null:Number(x);}
function setupV39ShelfLifeScheduler(token){try{_requireAuth_(token,'journals');_v39Init_();return _ok_({initialized:true,sheets:Object.keys(MC_V39).map(function(k){return MC_V39[k];})},'V39_SETUP');}catch(e){return _failFrom_(e);}}
function _v39Resolve_(ttkId,token){var r=JSON.parse(v38ResolveRule(ttkId,token));if(!r.success||!r.data||r.data.status!=='OK')return r;return r;}
function v39BuildWindow(json,token){var op=null;try{op=_beginOp_(token,'journals','V39_WINDOW','Build production window',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v39Init_();var d=typeof json==='string'?JSON.parse(json||'{}'):json||{};if(!d.ttkId||!d.eventAt)throw new Error('ttkId и eventAt обязательны');var rr=_v39Resolve_(d.ttkId,token);if(!rr.success||!rr.data||rr.data.status!=='OK')return rr;var x=rr.data,r=x.rule,eventAt=new Date(d.eventAt),shelf=_v39Hours_(r.shelfLifeHours),real=_v39Hours_(r.realizationHours),freezeShelf=_v39Hours_(r.freezeShelfLifeHours);var earliest=null,latest=null,freezeLatest=null,useBy=eventAt,warning='',status='OK';if(shelf!==null)earliest=new Date(eventAt.getTime()-shelf*3600000);if(real!==null)latest=new Date(eventAt.getTime()-real*3600000);if(freezeShelf!==null)freezeLatest=new Date(eventAt.getTime()-freezeShelf*3600000);if(latest&&earliest&&latest<earliest){status='INVALID_RULE';warning='Правило даёт несовместимое окно: срок реализации длиннее срока хранения.';}if(!real&&!shelf&&!freezeShelf){status='NO_WINDOW';warning='Нет утверждённых сроков для расчёта производственного окна.';}if(r.freezeAllowed===true||String(r.freezeAllowed).toUpperCase()==='TRUE'){if(!freezeShelf)warning=(warning?warning+' ':'')+'Заморозка разрешена, но срок хранения в заморозке не задан.';}else if(freezeShelf!==null){warning=(warning?warning+' ':'')+'Указан срок замороженного хранения, но заморозка не разрешена правилом.';}var id=d.windowId||_v39Id_('WIN',d.ttkId+'|'+eventAt.toISOString()+'|'+(d.batchId||'')+'|'+(d.eventId||''));_book_().getSheetByName(MC_V39.WINDOW).appendRow([id,d.ttkId,x.ttk.name,d.batchId||'',d.eventId||'',eventAt,d.needQty||'',r.id,r.regime,shelf,real,r.freezeAllowed,freezeShelf,earliest,latest,freezeLatest,useBy,status,warning,new Date()]);if(status!=='OK'){_book_().getSheetByName(MC_V39.ALERT).appendRow([_v39Id_('ALT',id),id,status==='INVALID_RULE'?'HIGH':'MEDIUM',status,d.ttkId,x.ttk.name,d.eventId||'',warning,'Проверить правило срока до планирования производства.','OPEN',new Date()]);} _audit_(op,'V39_WINDOW','PRODUCTION_WINDOW',id,null,{ttkId:d.ttkId,eventAt:d.eventAt});_endOp_(op);return _ok_({windowId:id,ttk:x,eventAt:eventAt,earliestProductionAt:earliest,latestProductionAt:latest,freezeLatestProductionAt:freezeLatest,status:status,warning:warning},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v39CheckProductionAt(windowId,productionAt,token){try{_requireAuth_(token,'journals');_v39Init_();var r=_v39Rows_(MC_V39.WINDOW).filter(function(x){return String(x[0])===String(windowId);})[0];if(!r)throw new Error('Окно не найдено: '+windowId);var p=new Date(productionAt),ear=r[13]?new Date(r[13]):null,late=r[14]?new Date(r[14]):null,fe=r[15]?new Date(r[15]):null,status='OK',warning='';if(ear&&p<ear){status='TOO_EARLY';warning='Производство слишком раннее: к моменту события срок хранения может быть исчерпан.';}if(late&&p>late){status='TOO_LATE';warning='Производство слишком позднее: продукт не будет иметь требуемого срока до события.';}if(!late&&!ear){status='NO_WINDOW';warning='Для ТТК нет полного производственного окна.';}return _ok_({windowId:windowId,productionAt:p,earliestProductionAt:ear,latestProductionAt:late,freezeLatestProductionAt:fe,status:status,warning:warning},'V39_CHECK');}catch(e){return _failFrom_(e);}}
function v39BuildBanquetWindows(json,token){try{_requireAuth_(token,'journals');_v39Init_();var d=typeof json==='string'?JSON.parse(json||'{}'):json||{};var items=d.items||[];if(!items.length)throw new Error('items пуст');var out=[];items.forEach(function(i){var r=JSON.parse(v39BuildWindow(i,token));out.push(r.success&&r.data?r.data:r);});return _ok_({count:out.length,items:out},'V39_BATCH_WINDOWS');}catch(e){return _failFrom_(e);}}
function v39GetDashboard(token){try{_requireAuth_(token,'journals');_v39Init_();var w=_v39Rows_(MC_V39.WINDOW),a=_v39Rows_(MC_V39.ALERT);return _ok_({windows:w,windowCount:w.length,openAlerts:a.filter(function(x){return String(x[9]).toUpperCase()==='OPEN';}),alertCount:a.length},'V39_DASH');}catch(e){return _failFrom_(e);}}
