/** MON CHEF V29 — ФАКТИЧЕСКИЙ БАНКЕТ И ЗАКРЫТИЕ
 *
 * Замыкает операционный цикл:
 * план -> выпуск -> выдача -> фактически обслужено -> возврат/брак -> закрытие.
 *
 * Важный принцип: система не придумывает фактические количества. Повар/менеджер
 * вводит served/returned/waste. Возвращённая готовая продукция по умолчанию
 * НЕ возвращается автоматически в свободный склад: она попадает в карантин,
 * пока ответственное лицо не примет отдельное решение.
 */
var MC_V29_CLOSE_SHEET='Закрытие_V29';
var MC_V29_FACT_SHEET='Факт_Банкет_V29';
var MC_V29_QUAR_SHEET='Карантин_Возврат_V29';
function _mcV29Sheet_(name,headers){var sh=_book_().getSheetByName(name);if(!sh){sh=_book_().insertSheet(name);sh.appendRow(headers);sh.setFrozenRows(1);}return sh;}
function _mcV29CloseSheet_(){return _mcV29Sheet_(MC_V29_CLOSE_SHEET,['ClosureID','EventID','EventDate','EventTime','Status','IssuedCost','ServedQty','ReturnedQty','WasteQty','ClosedAt','ClosedBy','Note','CreatedAt']);}
function _mcV29FactSheet_(){return _mcV29Sheet_(MC_V29_FACT_SHEET,['FactID','EventID','EventDate','DishCode','DishName','IssuedQty','ServedQty','ReturnedQty','WasteQty','Unit','Cost','WasteReason','RecordedAt','RecordedBy','Status']);}
function _mcV29QuarSheet_(){return _mcV29Sheet_(MC_V29_QUAR_SHEET,['ReturnID','EventID','DishCode','DishName','Qty','Unit','IssueRef','ReturnedAt','ReturnedBy','Status','Decision','DecisionAt','DecisionBy','Note']);}
function _mcV29Num_(x){var n=Number(String(x==null?'':x).replace(',','.'));return isFinite(n)?n:0;}
function _mcV29Norm_(x){return _prodKey_(String(x||''));}
function _mcV29ExistingClose_(eventId){var v=_mcV29CloseSheet_().getDataRange().getValues();for(var i=1;i<v.length;i++)if(String(v[i][1])===String(eventId)&&String(v[i][4])==='CLOSED')return {row:i+1,id:v[i][0]};return null;}
function _mcV29Issues_(eventId){var v=_mcV28Sheet_().getDataRange().getValues(),m={};for(var i=1;i<v.length;i++){if(String(v[i][1])!==String(eventId)||String(v[i][12])!=='ISSUED')continue;var code=String(v[i][4]||''),name=String(v[i][5]||''),k=code||_mcV29Norm_(name);if(!m[k])m[k]={code:code,name:name,unit:String(v[i][8]||'порц.'),issued:0,cost:0,issueRefs:[]};m[k].issued+=_mcV29Num_(v[i][7]);m[k].cost+=_mcV29Num_(v[i][13]);m[k].issueRefs.push(String(v[i][0]));}return m;}
function _mcV29Facts_(eventId){var v=_mcV29FactSheet_().getDataRange().getValues(),m={};for(var i=1;i<v.length;i++){if(String(v[i][1])!==String(eventId)||String(v[i][14])!=='RECORDED')continue;var k=String(v[i][3]||'')||_mcV29Norm_(v[i][4]);if(!m[k])m[k]={served:0,returned:0,waste:0,cost:0,rows:[]};m[k].served+=_mcV29Num_(v[i][6]);m[k].returned+=_mcV29Num_(v[i][7]);m[k].waste+=_mcV29Num_(v[i][8]);m[k].cost+=_mcV29Num_(v[i][10]);m[k].rows.push(i+1);}return m;}
function getV29BanquetClosure(eventId,token){try{_requireAuth_(token,'banquets');var e=_getEventById_(eventId);if(!e)throw new Error('Банкет не найден: '+eventId);var issues=_mcV29Issues_(eventId),facts=_mcV29Facts_(eventId),rows=[],tot={issued:0,served:0,returned:0,waste:0,cost:0};Object.keys(issues).forEach(function(k){var x=issues[k],f=facts[k]||{served:0,returned:0,waste:0};var accounted=f.served+f.returned+f.waste;rows.push({code:x.code,name:x.name,unit:x.unit,issuedQty:x.issued,servedQty:f.served,returnedQty:f.returned,wasteQty:f.waste,unaccounted:Math.max(0,x.issued-accounted),issueRefs:x.issueRefs,cost:x.cost,status:Math.abs(accounted-x.issued)<=0.0001?'ACCOUNTED':'OPEN'});tot.issued+=x.issued;tot.served+=f.served;tot.returned+=f.returned;tot.waste+=f.waste;tot.cost+=x.cost;});var c=_mcV29ExistingClose_(eventId);return _ok_({event:{id:e.id,date:e.date,time:e.time||'',format:e.format||e.name||'Банкет',place:e.place||'',guests:e.guests||0},rows:rows,total:tot,closed:!!c,closureId:c?c.id:'',readyToClose:rows.every(function(r){return r.status==='ACCOUNTED';})});}catch(e){return _failFrom_(e);}}
function closeV29Banquet(eventId,linesJson,note,token){var op=null;try{op=_beginOp_(token,'banquets','BANQUET_CLOSE','Банкет',eventId,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){var e=_getEventById_(eventId);if(!e)throw new Error('Банкет не найден: '+eventId);if(_mcV29ExistingClose_(eventId)){_endOp_(op,'FAILED');return _fail_('ALREADY_CLOSED','Банкет уже закрыт',op.id);}var issues=_mcV29Issues_(eventId);var lines=typeof linesJson==='string'?JSON.parse(linesJson||'[]'):linesJson;if(!Array.isArray(lines))throw new Error('Некорректные фактические строки');var facts=_mcV29Facts_(eventId),prepared=[],servedItems=[],now=new Date(),actor=(op.session&&op.session.fullName)||'';Object.keys(issues).forEach(function(k){var x=issues[k],f=facts[k]||{served:0,returned:0,waste:0};var l=null;for(var i=0;i<lines.length;i++){var lk=String(lines[i].code||'')||_mcV29Norm_(lines[i].name);if(lk===k){l=lines[i];break;}}var served=_mcV29Num_(l&&l.servedQty),returned=_mcV29Num_(l&&l.returnedQty),waste=_mcV29Num_(l&&l.wasteQty),reason=String((l&&l.wasteReason)||'');if(served<0||returned<0||waste<0)throw new Error('Отрицательное количество: '+x.name);var deltaServed=served,deltaReturned=returned,deltaWaste=waste;var total=deltaServed+deltaReturned+deltaWaste;if(Math.abs(total-x.issued)>0.0001)throw new Error('Не распределено выданное количество: '+x.name+'. Выдано '+x.issued+', указано '+total);prepared.push({key:k,code:x.code,name:x.name,unit:x.unit,issued:x.issued,served:deltaServed,returned:deltaReturned,waste:deltaWaste,cost:x.cost,reason:reason,issueRefs:x.issueRefs});if(deltaServed>0)servedItems.push({name:x.name,qty:deltaServed,unit:x.unit});});var totalServed=0,totalReturned=0,totalWaste=0,totalCost=0;prepared.forEach(function(x){var id='V29F-'+Utilities.getUuid();_mcV29FactSheet_().appendRow([id,eventId,e.date,x.code,x.name,x.issued,x.served,x.returned,x.waste,x.unit,x.cost,x.reason,now,actor,'RECORDED']);totalServed+=x.served;totalReturned+=x.returned;totalWaste+=x.waste;totalCost+=x.cost;if(x.returned>0){var rid='V29R-'+Utilities.getUuid();_mcV29QuarSheet_().appendRow([rid,eventId,x.code,x.name,x.returned,x.unit,x.issueRefs.join(','),now,actor,'QUARANTINE','','','', 'Возврат с банкета — автоматический возврат на свободный склад запрещён']);}try{if(typeof _mcCreateFactInternal_==='function')_mcCreateFactInternal_({factType:'BANQUET_CLOSED_LINE',objectType:'BANQUET',objectId:eventId,operationType:'BANQUET_FACT',dateTime:now,value:x.served,unit:x.unit,result:'RECORDED',source:'V29',employeeName:actor,description:x.name+'; выдано='+x.issued+'; обслужено='+x.served+'; возврат='+x.returned+'; брак='+x.waste,skipRules:true},op.session);}catch(ignore){}});/* этап 10.8: продажа фиксируется при выдаче (J36), брак/остатки — в фактах закрытия и карантине возвратов, не в журнале бракеража */var cid='V29C-'+Utilities.getUuid();_mcV29CloseSheet_().appendRow([cid,eventId,e.date,e.time||'','CLOSED',Math.round(totalCost*100)/100,Math.round(totalServed*1000)/1000,Math.round(totalReturned*1000)/1000,Math.round(totalWaste*1000)/1000,now,actor,note||'',now]);_audit_(op,'BANQUET_CLOSE','Банкет',eventId,null,{closureId:cid,served:totalServed,returned:totalReturned,waste:totalWaste,cost:Math.round(totalCost*100)/100});_endOp_(op);return _ok_({closureId:cid,eventId:eventId,status:'CLOSED',servedQty:totalServed,returnedQty:totalReturned,wasteQty:totalWaste,issuedCost:Math.round(totalCost*100)/100},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function getV29BanquetDashboard(token){try{_requireAuth_(token,'banquets');var evs=JSON.parse(getEvents()),out=[];evs.slice().reverse().slice(0,100).forEach(function(e){try{var r=_mcV22Parse_(getV29BanquetClosure(e.id,token));if(r&&(r.ok||r.success)){var d=r.data;out.push({id:e.id,date:e.date,time:e.time||'',format:e.format||e.name||'Банкет',guests:e.guests||0,closed:d.closed,readyToClose:d.readyToClose,issued:d.total.issued,served:d.total.served,returned:d.total.returned,waste:d.total.waste,cost:d.total.cost,openRows:d.rows.filter(function(x){return x.status!=='ACCOUNTED';}).length});}}catch(ignore){}});return _ok_(out);}catch(e){return _failFrom_(e);}}
