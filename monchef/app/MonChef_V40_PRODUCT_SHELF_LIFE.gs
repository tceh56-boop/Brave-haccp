/** MON CHEF V40 — PRODUCT SHELF-LIFE MASTER
 * Imports the user's 1218-product database into a controlled reference layer.
 * IMPORTANT: imported values are REFERENCE/REVIEW data, not legal approval.
 */
var MC_V40={PRODUCT:'Продукты_Сроки_V40',MAP:'ТТК_Состав_Продукты_V40',GAP:'Продукты_Сроки_Пробелы_V40'};
var MC_V40_H={
 PRODUCT:['ProductID','No','ProductName','ProductType','StorageText','RoomShelfRaw','FridgeShelfRaw','FreezerShelfRaw','RoomShelfHours','FridgeShelfHours','FreezerShelfHours','SpoilageSigns','Notes','SourceFile','SourceStatus','ApprovalStatus','ImportedAt','UpdatedAt'],
 MAP:['MapID','TTK_ID','RawName','ProductID','MatchedProductName','MatchMethod','Confidence','FridgeShelfHours','FreezerShelfHours','StorageText','SourceStatus','ReviewStatus','UpdatedAt'],
 GAP:['GapID','RawName','TTK_ID','GapType','Description','Severity','Status','CreatedAt']
};
function _v40Sheet_(n,h){var s=_book_().getSheetByName(n);if(!s){s=_book_().insertSheet(n);s.getRange(1,1,1,h.length).setValues([h]);s.setFrozenRows(1);}return s;}
function _v40Init_(){Object.keys(MC_V40).forEach(function(k){_v40Sheet_(MC_V40[k],MC_V40_H[k]);});}
function _v40Rows_(n){var s=_book_().getSheetByName(n);if(!s||s.getLastRow()<2)return[];return s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues();}
function _v40Norm_(s){return String(s||'').toLowerCase().replace(/ё/g,'е').replace(/[^a-zа-я0-9]+/gi,' ').replace(/\s+/g,' ').trim();}
function _v40Id_(p,k){var b=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(k||''),Utilities.Charset.UTF_8);return p+'-'+b.map(function(x){x=x<0?x+256:x;var h=x.toString(16);return h.length===1?'0'+h:h;}).join('').substring(0,16).toUpperCase();}
function setupV40ProductShelfLife(token){try{_requireAuth_(token,'journals');_v40Init_();return _ok_({initialized:true,sheets:Object.keys(MC_V40).map(function(k){return MC_V40[k];}),message:'База сроков продуктов создана как REFERENCE/REVIEW. Юридическое утверждение выполняется отдельно.'},'V40_SETUP');}catch(e){return _failFrom_(e);}}
function _v40Seed_(){var html=HtmlService.createHtmlOutputFromFile('ProductShelfLifeSeed').getContent();var m=html.match(/window\.MONCHEF_V40_PRODUCTS=(.*);<\/script>/s);if(!m)throw new Error('Seed V40 не найден');return JSON.parse(m[1]);}
function v40SeedFromBundle(token){var op=null;try{op=_beginOp_(token,'journals','V40_SEED','Seed product shelf-life database',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v40Init_();var sh=_book_().getSheetByName(MC_V40.PRODUCT),items=_v40Seed_(),existing={};_v40Rows_(MC_V40.PRODUCT).forEach(function(r){existing[String(r[0])]=true;});var now=new Date(),added=0,updated=0;items.forEach(function(x){var id=_v40Id_('PROD',String(x.no)+'|'+x.name),row=[id,x.no,x.name,x.type,x.storage,x.roomRaw,x.fridgeRaw,x.freezerRaw,x.roomH,x.fridgeH,x.freezerH,x.spoilage,x.notes,'Полная_база_продуктов_ИТОГ(1).xlsx','IMPORTED_REFERENCE','REVIEW',now,now];if(existing[id]){var vals=sh.getDataRange().getValues(),ri=-1;for(var i=1;i<vals.length;i++)if(String(vals[i][0])===id){ri=i+1;break;}if(ri>0)sh.getRange(ri,1,1,row.length).setValues([row]);updated++;}else{sh.appendRow(row);added++;}});_endOp_(op);return _ok_({total:items.length,added:added,updated:updated,status:'REVIEW',note:'Сроки импортированы как справочные данные и не считаются утверждёнными нормативными сроками.'},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function _v40ProductIndex_(){var map={};_v40Rows_(MC_V40.PRODUCT).forEach(function(r){var k=_v40Norm_(r[2]);if(k)map[k]=r;});return map;}
function _v40BestProduct_(name,index){var k=_v40Norm_(name);if(!k)return null;if(index[k])return {r:index[k],method:'EXACT',confidence:1};var best=null,bestScore=0;Object.keys(index).forEach(function(key){var a=k.split(' '),b=key.split(' '),set={};a.forEach(function(x){set[x]=1;});var inter=0;b.forEach(function(x){if(set[x])inter++;});var union=a.length+b.length-inter;var score=union?inter/union:0;if((key.indexOf(k)>=0||k.indexOf(key)>=0)&&score>=0.5&&score>bestScore){best=index[key];bestScore=score;}});return best?{r:best,method:'CONTAINS',confidence:bestScore}:null;}
function v40BuildTtkProductMap(token){var op=null;try{op=_beginOp_(token,'journals','V40_MAP','Map TTK ingredients to product shelf-life database',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v40Init_();if(typeof _v36Rows_!=='function')throw new Error('V36 TTK Master не установлен');var ings=_v36Rows_(MC_V36.ING),index=_v40ProductIndex_(),sh=_book_().getSheetByName(MC_V40.MAP),gap=_book_().getSheetByName(MC_V40.GAP);var old=sh.getDataRange().getValues();for(var i=old.length-1;i>=1;i--)sh.deleteRow(i+1);var go=gap.getDataRange().getValues();for(var j=go.length-1;j>=1;j--)gap.deleteRow(j+1);var exact=0,partial=0,none=0;ings.forEach(function(x){var m=_v40BestProduct_(x[2],index);if(m){var r=m.r,method=m.method,conf=m.confidence;if(method==='EXACT')exact++;else partial++;sh.appendRow([_v40Id_('MAP',x[0]+'|'+x[1]),x[0],x[2],r[0],r[2],method,conf,r[9]||'',r[10]||'',r[4]||'',r[14]||'IMPORTED_REFERENCE','REVIEW',new Date()]);}else{none++;gap.appendRow([_v40Id_('GAP',x[0]+'|'+x[1]),x[2],x[0],'PRODUCT_NOT_FOUND','Ингредиент ТТК не сопоставлен с базой продуктов.','MEDIUM','OPEN',new Date()]);}});_endOp_(op);return _ok_({ttkIngredientRows:ings.length,exact:exact,partial:partial,notFound:none,note:'Все сопоставления имеют статус REVIEW до подтверждения ответственным.'},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v40GetProduct(productName,token){try{_requireAuth_(token,'journals');_v40Init_();var idx=_v40ProductIndex_(),m=_v40BestProduct_(productName,idx);if(!m)return _ok_({status:'NOT_FOUND',productName:productName},'V40_GET');var r=m.r;return _ok_({status:'REVIEW',productId:r[0],productName:r[2],productType:r[3],storage:r[4],roomShelfRaw:r[5],fridgeShelfRaw:r[6],freezerShelfRaw:r[7],roomShelfHours:r[8],fridgeShelfHours:r[9],freezerShelfHours:r[10],spoilage:r[11],sourceStatus:r[14],approvalStatus:r[15],matchMethod:m.method,confidence:m.confidence},'V40_GET');}catch(e){return _failFrom_(e);}}
function v40GetDashboard(token){try{_requireAuth_(token,'journals');_v40Init_();var p=_v40Rows_(MC_V40.PRODUCT),m=_v40Rows_(MC_V40.MAP),g=_v40Rows_(MC_V40.GAP);return _ok_({products:p.length,withFridgeShelf:p.filter(function(x){return x[9]!=='';}).length,withFreezerShelf:p.filter(function(x){return x[10]!=='';}).length,mappedExact:m.filter(function(x){return x[5]==='EXACT';}).length,mappedPartial:m.filter(function(x){return x[5]==='CONTAINS';}).length,notFound:g.length,productsReview:p.filter(function(x){return String(x[15])!=='APPROVED';}).length},'V40_DASH');}catch(e){return _failFrom_(e);}}
