/**
 * MON CHEF V32 — OPERATIONAL EVENT → HACCP TASK BRIDGE
 * Реальные производственные события автоматически создают задачи HACCP.
 * Система не создаёт фактические значения и не задаёт нормативы.
 */
var MC_V32={TRIGGER:'HACCP_Триггеры_V32',EVENT:'HACCP_События_V32'};
function _v32Sheet_(n,h){var s=_book_().getSheetByName(n);if(!s){s=_book_().insertSheet(n);s.appendRow(h);s.setFrozenRows(1);}return s;}
function _v32Init_(){
 _v32Sheet_(MC_V32.TRIGGER,['TriggerID','EventType','ControlID','DelayMinutes','ObjectTemplate','Parameter','Responsible','Enabled','CreatedAt','CreatedBy']);
 _v32Sheet_(MC_V32.EVENT,['EventID','EventType','ObjectType','ObjectID','EventAt','Source','Actor','Payload','TasksCreated','CreatedAt']);
}
function _v32Rows_(n){var s=_book_().getSheetByName(n);if(!s)return[];var v=s.getDataRange().getValues();return v.length>1?v.slice(1):[];}
function setupV32EventBridge(token){try{_requireAuth_(token,'journals');_v32Init_();return _ok_({initialized:true},'V32_SETUP');}catch(e){return _failFrom_(e);}}
function v32SaveTrigger(json,token){var op=null;try{op=_beginOp_(token,'journals','V32_TRIGGER_SAVE','HACCP event trigger',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v32Init_();var d=typeof json==='string'?JSON.parse(json||'{}'):(json||{});if(!d.eventType||!d.controlId)throw new Error('eventType и controlId обязательны');var sh=_v32Sheet_(MC_V32.TRIGGER),id=d.triggerId||'H32T-'+Utilities.getUuid(),r=[id,String(d.eventType).toUpperCase(),d.controlId,Number(d.delayMinutes)||0,d.objectTemplate||'',d.parameter||'',d.responsible||'',d.enabled!==false,new Date(),_mcSessionFullName_(op.session)];var v=sh.getDataRange().getValues(),row=-1;for(var i=1;i<v.length;i++)if(String(v[i][0])===String(id)){row=i+1;break;}if(row<0)sh.appendRow(r);else sh.getRange(row,1,1,r.length).setValues([r]);_audit_(op,'V32_TRIGGER_SAVE','HACCP_TRIGGER',id,null,{eventType:d.eventType,controlId:d.controlId});_endOp_(op);return _ok_({triggerId:id},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v32GetTriggers(token){try{_requireAuth_(token,'journals');_v32Init_();return _ok_({triggers:_v32Rows_(MC_V32.TRIGGER).map(function(r){return{triggerId:r[0],eventType:r[1],controlId:r[2],delayMinutes:r[3],objectTemplate:r[4],parameter:r[5],responsible:r[6],enabled:r[7]!==false};})},'V32_TRIGGERS');}catch(e){return _failFrom_(e);}}
function _v32RenderObject_(template,e){var s=String(template||'');return s.replace(/\{objectId\}/g,String(e.objectId||'')).replace(/\{objectType\}/g,String(e.objectType||''));}
function v32EmitOperationalEvent(json,token){var op=null;try{op=_beginOp_(token,'journals','V32_EVENT','Operational event',null,null);}catch(e){return _failFrom_(e);}try{return _withLock_(function(){_v32Init_();_v31Init_();var e=typeof json==='string'?JSON.parse(json||'{}'):(json||{});if(!e.eventType||!e.objectId)throw new Error('eventType и objectId обязательны');var eventId=e.eventId||'H32E-'+Utilities.getUuid(),at=e.eventAt?new Date(e.eventAt):new Date(),actor=_mcSessionFullName_(op.session),tr=_v32Rows_(MC_V32.TRIGGER).filter(function(r){return r[7]!==false&&String(r[1]).toUpperCase()===String(e.eventType).toUpperCase();});var created=[];var taskSheet=_v31Sheet_(MC_V31.TASK);var tv=taskSheet.getDataRange().getValues();tr.forEach(function(t){var due=new Date(at.getTime()+Number(t[3]||0)*60000),obj=_v32RenderObject_(t[4],e),param=t[5]||'';var duplicate=false;for(var i=1;i<tv.length;i++){if(String(tv[i][1])===String(t[2])&&String(tv[i][7])==='OPEN'&&String(tv[i][4])===String(obj)){duplicate=true;break;}}if(!duplicate){var tid='H32TASK-'+Utilities.getUuid();taskSheet.appendRow([tid,t[2],'',due,obj,param,t[6]||'', 'OPEN','','','',new Date(),actor]);created.push({taskId:tid,controlId:t[2],dueAt:due,object:obj,parameter:param});}});_v32Sheet_(MC_V32.EVENT).appendRow([eventId,String(e.eventType).toUpperCase(),e.objectType||'',e.objectId,at,e.source||'OPERATION',actor,JSON.stringify(e.payload||{}),created.length,new Date()]);_audit_(op,'V32_EVENT','OPERATIONAL_EVENT',eventId,null,{eventType:e.eventType,objectId:e.objectId,tasksCreated:created.length});_endOp_(op);return _ok_({eventId:eventId,tasksCreated:created},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function v32GetEventQueue(token){try{_requireAuth_(token,'journals');_v31Init_();var now=new Date(),tasks=_v31Rows_(MC_V31.TASK).filter(function(r){return String(r[7])==='OPEN';}).map(function(r){return{id:r[0],controlId:r[1],dueAt:r[3],object:r[4],parameter:r[5],responsible:r[6],overdue:r[3] instanceof Date&&r[3]<now};}).sort(function(a,b){return new Date(a.dueAt)-new Date(b.dueAt);});return _ok_({tasks:tasks,overdue:tasks.filter(function(x){return x.overdue;}).length},'V32_QUEUE');}catch(e){return _failFrom_(e);}}
function v32SeedCommonEventTypes(token){try{_requireAuth_(token,'journals');_v32Init_();var existing=_v32Rows_(MC_V32.TRIGGER);var types=['RECEIVING_CONFIRMED','PRODUCTION_STARTED','PRODUCTION_COMPLETED','COOLING_STARTED','REHEATING_STARTED','BANQUET_ISSUE'];var missing=types.filter(function(t){return !existing.some(function(r){return String(r[1])===t;});});return _ok_({availableEventTypes:types,notConfigured:missing},'V32_EVENT_TYPES');}catch(e){return _failFrom_(e);}}
