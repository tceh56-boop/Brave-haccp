/** MON CHEF V28 — БАНКЕТ: КОМПЛЕКТАЦИЯ И ВЫДАЧА ГОТОВОЙ ПРОДУКЦИИ
 *
 * Замыкает цикл: готовая партия -> комплектация банкета -> фактическая выдача.
 * Резерв сырья V26/V27 и выдача готовых блюд — разные операции и не дублируют
 * списание. Перед фактической выдачей система проверяет наличие готовых партий FEFO.
 * Фактические количества вводит сотрудник; система их не придумывает.
 */
var MC_V28_ISSUE_SHEET='Выдача_V28';
function _mcV28Sheet_(){var sh=_book_().getSheetByName(MC_V28_ISSUE_SHEET);if(!sh){sh=_book_().insertSheet(MC_V28_ISSUE_SHEET);sh.appendRow(['IssueID','EventID','EventDate','EventTime','DishCode','DishName','PlannedQty','IssuedQty','Unit','BatchIDs','IssuedAt','IssuedBy','Status','Cost','Note']);sh.setFrozenRows(1);}return sh;}
function _mcV28Norm_(x){return _prodKey_(String(x||''));}
function _mcV28Num_(x){var n=Number(String(x==null?'':x).replace(',','.'));return isFinite(n)?n:0;}
function _mcV28Event_(id){var e=_getEventById_(id);if(!e)throw new Error('Банкет не найден: '+id);return e;}
function _mcV28Existing_(eventId){var v=_mcRO_('v28issue',function(){return _mcV28Sheet_().getDataRange().getValues();}),m={};for(var i=1;i<v.length;i++){if(String(v[i][1])!==String(eventId))continue;var k=String(v[i][4])||_mcV28Norm_(v[i][5]);if(!m[k])m[k]={planned:_mcV28Num_(v[i][6]),issued:0,unit:v[i][8]||'порц.',rows:[]};m[k].issued+=_mcV28Num_(v[i][7]);m[k].rows.push({row:i+1,issueId:v[i][0],qty:_mcV28Num_(v[i][7]),batchIds:v[i][9]||'',status:v[i][12]});}return m;}
function _mcV28DishIndex_(){var idx=_mcRO_('dishIdx',_buildDishIndexes_);return idx.dishByCode||{};}
function getV28BanquetFulfillment(eventId,token){try{_requireAuth_(token,'banquets');var e=_mcV28Event_(eventId),idx=_mcV28DishIndex_(),done=_mcV28Existing_(eventId),items=e.items||[],rows=[];items.forEach(function(it){var d=idx[String(it.code)]||null,name=d?d.name:(it.name||it.code||'');var code=String(it.code||'');var planned=_mcV28Num_(it.qty),k=code||_mcV28Norm_(name),x=done[k]||{issued:0};var issued=_mcV28Num_(x.issued),remaining=Math.max(0,planned-issued),fe={batches:[],uncovered:remaining};if(remaining>0){var r=_mcV22Parse_(getFEFOBatches(name,remaining,token));if(r&&(r.ok||r.success)){fe=r.data||fe;}}rows.push({code:code,name:name,plannedQty:planned,issuedQty:issued,remainingQty:remaining,unit:'порц.',batches:fe.batches||[],uncovered:_mcV28Num_(fe.uncovered),status:remaining<=0?'ISSUED':(_mcV28Num_(fe.uncovered)>0?'SHORTAGE':'READY')});});return _ok_({event:{id:e.id,date:e.date,time:e.time||'',format:e.format||e.name||'Банкет',place:e.place||'',guests:e.guests||0},rows:rows,ready:rows.every(function(x){return x.status==='ISSUED'||x.status==='READY';}),complete:rows.every(function(x){return x.status==='ISSUED';})});}catch(e){return _failFrom_(e);}}
function issueV28Banquet(eventId,linesJson,token){var op=null;try{op=_beginOp_(token,'banquets','BANQUET_ISSUE','Банкет',eventId,null);}catch(a){return _failFrom_(a);}try{return _withLock_(function(){var e=_mcV28Event_(eventId),lines=typeof linesJson==='string'?JSON.parse(linesJson||'[]'):linesJson;if(!Array.isArray(lines)||!lines.length){_endOp_(op,'FAILED');return _fail_('VALIDATION','Передайте строки выдачи',op.id);}var idx=_mcV28DishIndex_(),done=_mcV28Existing_(eventId),prepared=[];lines.forEach(function(l){var code=String(l.code||''),d=idx[code],name=d?d.name:(l.name||'');if(!name)throw new Error('Не найдено блюдо: '+code);var planned=_mcV28Num_(l.plannedQty)||_mcV28Num_(l.qtyPlanned),issued=_mcV28Num_((done[code]||{}).issued),q=_mcV28Num_(l.qty||l.issueQty);if(!(q>0))throw new Error('Количество выдачи должно быть больше нуля: '+name);if(issued+q>planned+0.0001)throw new Error('Выдача больше плана: '+name+' ('+(issued+q)+' > '+planned+')');var fe=_mcV22Parse_(getFEFOBatches(name,q,token));if(!(fe.success||fe.ok))throw new Error((fe.error&&fe.error.message)||('FEFO не найден: '+name));var uncovered=_mcV28Num_((fe.data||{}).uncovered);if(uncovered>0.0001)throw new Error('Недостаток готовой продукции: '+name+', не хватает '+uncovered+' порц.');((fe.data||{}).batches||[]).forEach(function(bb){if(!(_mcV28Num_(bb.suggestedQty)>0))return;var rs=_bcReleaseState_(bb.batchId);if(!rs.ok)throw new Error('ISSUE_BLOCKED: «'+name+'», партия '+bb.batchId+' не допущена к выдаче — '+rs.reasons.join('; '));});prepared.push({code:code,name:name,qty:q,planned:planned});});
var created=[],now=new Date(),actor=(op.session&&op.session.fullName)||'';prepared.forEach(function(x){var consumed=_fifoConsume_(x.name,'порц.',x.qty),covered=consumed.reduce(function(s,z){return s+_mcV28Num_(z.qty);},0);if(covered+0.0001<x.qty)throw new Error('Во время выдачи изменился остаток: '+x.name);var source='Банкет '+(e.format||e.name||'Банкет')+' '+e.date+' ('+eventId+')';_logStockOp_('Расход',x.name,x.qty,'порц.',0,source,'Фактическая выдача готовой продукции V28');var cost=_currentAvgPrice_(x.name,'порц.')||0;var batchIds=consumed.map(function(z){return z.batchId;}).join(',');var id='V28ISS-'+Utilities.getUuid();_mcV28Sheet_().appendRow([id,eventId,e.date,e.time||'',x.code,x.name,x.planned,x.qty,'порц.',batchIds,now,actor,'ISSUED',Math.round(cost*x.qty*100)/100,'']);created.push({issueId:id,code:x.code,name:x.name,qty:x.qty,batchIds:batchIds,cost:Math.round(cost*x.qty*100)/100});consumed.forEach(function(z){try{if(typeof _mcCreateTraceLink_==='function')_mcCreateTraceLink_('BATCH',String(z.batchId),'ВЫДАНА_НА_БАНКЕТ','BANQUET',String(eventId),{dateTime:now,actor:actor,qty:z.qty,unit:z.unit,issueId:id});}catch(ignore){}});try{if(typeof _mcCreateFactInternal_==='function')_mcCreateFactInternal_({factType:'BANQUET_ISSUE',objectType:'BANQUET',objectId:eventId,operationType:'ISSUE_FINISHED_PRODUCT',dateTime:now,value:x.qty,unit:'порц.',result:'RECORDED',source:'V28',employeeName:actor,description:'Выдача '+x.name+' на банкет '+eventId,skipRules:true},op.session);}catch(ignore2){}});var sales=0;try{sales=_mcSalesOnIssue_(e,eventId,created,op);}catch(eS){_log_('WARN','J36 при выдаче: '+eS,op.id);}_audit_(op,'BANQUET_ISSUE','Банкет',eventId,null,{lines:created.length,items:created,sales:sales});_endOp_(op);return _ok_({eventId:eventId,issued:created,salesRows:sales},op.id);});}catch(e){if(op)_endOp_(op,'FAILED');return _failFrom_(e,op&&op.id);}}
function getV28BanquetIssueHistory(eventId,token){try{_requireAuth_(token,'banquets');var v=_mcV28Sheet_().getDataRange().getValues(),out=[];for(var i=1;i<v.length;i++)if(!eventId||String(v[i][1])===String(eventId))out.push({issueId:v[i][0],eventId:v[i][1],date:v[i][2],time:v[i][3],code:v[i][4],name:v[i][5],plannedQty:_mcV28Num_(v[i][6]),issuedQty:_mcV28Num_(v[i][7]),unit:v[i][8],batchIds:v[i][9],issuedAt:v[i][10],issuedBy:v[i][11],status:v[i][12],cost:_mcV28Num_(v[i][13]),note:v[i][14]});return _ok_(out.reverse().slice(0,300));}catch(e){return _failFrom_(e);}}
function getV28BanquetDashboard(token){try{_requireAuth_(token,'banquets');var evs=JSON.parse(getEvents()),out=[];_mcWithRO_(function(){evs.slice().reverse().slice(0,100).forEach(function(e){try{var r=_mcV22Parse_(getV28BanquetFulfillment(e.id,token));if(r&&(r.ok||r.success)&&r.data)out.push({id:e.id,date:e.date,time:e.time||'',format:e.format||e.name||'Банкет',guests:e.guests||0,complete:r.data.complete,ready:r.data.ready,shortages:r.data.rows.filter(function(x){return x.status==='SHORTAGE';}).length,rows:r.data.rows.length});}catch(ignore){}});});return _ok_(out);}catch(e){return _failFrom_(e);}}

/** Этап 10.8 (ответ 4): выдача банкета — это продажа. Строка J36 на каждую выданную позицию: количество — выдано,
 *  цена — из банкета (если указана), сумма — расчёт; цену система не придумывает. Источник — «выдача банкета». */
function _mcSalesOnIssue_(e,eventId,created,op){
  var j=_mcJById_('J36');if(!j||!created.length)return 0;var sh=_book_().getSheetByName(j.sheetName)||_createJournalSheet_(j),now=new Date(),n=0;
  var price={};(e.items||[]).forEach(function(it){var p=parseFloat(it.price);if(p>0)price[String(it.code)]=p;});
  created.forEach(function(x){var p=price[String(x.code)]||'',sum=p?Math.round(p*x.qty*100)/100:'';
    var vals={'Дата':Utilities.formatDate(now,_mcTz_(),'dd.MM.yyyy'),'Время':Utilities.formatDate(now,_mcTz_(),'HH:mm'),'Блюдо':x.name,'Количество':x.qty,'Цена':p,'Сумма':sum,
      'ФИО продавца':'Выдача банкета '+eventId+(e.format?' «'+e.format+'»':'')+' (выдал '+((op.session&&op.session.fullName)||'')+')','Должность':(op.session&&op.session.position)||''};
    _mcJournalAppendTo_(sh,op,'выдача банкета',j.columns.map(function(c){return c==='№'?sh.getLastRow():(vals[c]!==undefined?vals[c]:'');}));n++;});
  return n;
}
