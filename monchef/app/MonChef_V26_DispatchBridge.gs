/** MON CHEF V26 — WEEKLY DISPATCH BRIDGE
 * Планировщик + FEFO + закупка. Только планирование/резервирование; фактический расход
 * по-прежнему подтверждается V23 сканированием партии.
 */
var MC_V26_PLAN='Диспетчер_V26';
function _mcV26Sheet_(name,headers){var s=_book_().getSheetByName(name);if(!s){s=_book_().insertSheet(name);s.appendRow(headers);s.setFrozenRows(1);}return s;}
function _mcV26Plan_(){return _mcV26Sheet_(MC_V26_PLAN,['DispatchID','PlanID','WeekFrom','TaskID','TaskDate','DueTime','Product','Unit','NeedQty','FEFOQty','Shortage','EarliestBatch','Location','ReserveStatus','PurchaseStatus','CreatedAt','CreatedBy']);}
function _mcV26Norm_(x){return _prodKey_(String(x||''));}
function _mcV26Rows_(from,token){var r=_mcV22Parse_(buildV25ProductionSchedule(from,token));if(!(r.ok||r.success))throw new Error(r.error&&r.error.message||'V25 schedule failed');return r.data;}
function _mcV26AggregateNeeds_(d){var m={};(d.rawPick||[]).forEach(function(x){var k=_mcV26Norm_(x.name)+'|'+String(x.unit||'');if(!m[k])m[k]={product:x.name,unit:x.unit,qty:0,due:x.due,taskIds:[]};m[k].qty+=Number(x.qty)||0;m[k].due=new Date(Math.min(new Date(m[k].due).getTime(),new Date(x.due).getTime()));m[k].taskIds.push(x.id);});return Object.keys(m).map(function(k){return m[k];});}
function buildV26Dispatch(fromDate,token){try{_requireAuth_(token,'kanban');var d=_mcV26Rows_(fromDate,token),needs=_mcV26AggregateNeeds_(d),out=[],shortages=[];needs.forEach(function(n){var fe=_mcV22Parse_(getFEFOBatches(n.product,n.qty,token));if(!(fe.ok||fe.success))throw new Error(fe.error&&fe.error.message||'FEFO error');var b=fe.data||{},arr=b.batches||[],covered=0;arr.forEach(function(x){covered+=Math.min(Number(x.available)||0,Math.max(0,n.qty-covered));});var shortage=Math.max(0,n.qty-covered),first=arr[0]||{};var status=shortage?'SHORTAGE':'READY';out.push({product:n.product,unit:n.unit,needQty:n.qty,fefoQty:covered,shortage:shortage,earliestBatch:first.batchId||'',location:first.locationId||'',due:n.due,taskIds:n.taskIds,reserveStatus:status,purchaseStatus:shortage?'REQUIRED':'NOT_REQUIRED'});if(shortage)shortages.push(out[out.length-1]);});return _ok_({planId:d.planId,weekFrom:d.weekFrom,weekTo:d.weekTo,rows:out,shortages:shortages,generatedAt:new Date()});}catch(e){return _failFrom_(e);}}
function publishV26Dispatch(fromDate,token){try{_requireAuth_(token,'kanban');var r0=buildV26Dispatch(fromDate,token),r=_mcV22Parse_(r0);if(!(r.ok||r.success))return r0;var sh=_mcV26Plan_(),actor=_mcV20Actor_(token),now=new Date(),rows=[];(r.data.rows||[]).forEach(function(x){rows.push(['V26-'+Utilities.getUuid(),r.data.planId,r.data.weekFrom,(x.taskIds||[]).join(','),_mcV25Date_(x.due),_mcV25Time_(x.due),x.product,x.unit,x.needQty,x.fefoQty,x.shortage,x.earliestBatch,x.location,x.reserveStatus,x.purchaseStatus,now,actor]);});if(rows.length)sh.getRange(sh.getLastRow()+1,1,rows.length,17).setValues(rows);return _ok_({count:rows.length,shortages:r.data.shortages,rows:r.data.rows});}catch(e){return _failFrom_(e);}}
function reserveV26Ready(fromDate,token){try{_requireAuth_(token,'stock');var r0=buildV26Dispatch(fromDate,token),r=_mcV22Parse_(r0);if(!(r.ok||r.success))return r0;var reserved=[],blocked=[],rv=_mcV22Res_().getDataRange().getValues();(r.data.rows||[]).forEach(function(x){if(x.shortage){blocked.push(x);return;}var active=0;for(var i=1;i<rv.length;i++)if(String(rv[i][9])==='ACTIVE'&&String(rv[i][3])==='WEEKLY_DISPATCH'&&String(rv[i][4])===String(r.data.planId)&&_mcV26Norm_(rv[i][1])===_mcV26Norm_(x.product))active+=Number(rv[i][5])||0;var need=Math.max(0,Number(x.needQty)-active);if(need<=0){reserved.push({product:x.product,qty:0,alreadyReserved:active});return;}var rr=reserveFEFO(x.product,need,x.unit,'WEEKLY_DISPATCH',r.data.planId,token);if(rr.ok)reserved.push({product:x.product,qty:need,data:rr.data});else blocked.push(Object.assign({},x,{reserveError:rr.error&&rr.error.message||'reserve failed'}));});return _ok_({planId:r.data.planId,reserved:reserved,blocked:blocked});}catch(e){return _failFrom_(e);}}

var MC_V26_PURCHASE='Закупки_V26';
function _mcV26Purchase_(){return _mcV26Sheet_(MC_V26_PURCHASE,['RequestID','PlanID','WeekFrom','Product','Unit','ShortageQty','NeedBy','Status','CreatedAt','CreatedBy']);}
function createV26PurchaseRequests(fromDate,token){try{_requireAuth_(token,'stock');var r0=buildV26Dispatch(fromDate,token),r=_mcV22Parse_(r0);if(!(r.ok||r.success))return r0;var sh=_mcV26Purchase_(),v=sh.getDataRange().getValues(),actor=_mcV20Actor_(token),now=new Date(),created=[];(r.data.shortages||[]).forEach(function(x){var exists=false;for(var i=1;i<v.length;i++)if(String(v[i][1])===String(r.data.planId)&&_mcV26Norm_(v[i][3])===_mcV26Norm_(x.product)&&String(v[i][7])!=='CANCELLED'){exists=true;break;}if(exists)return;var id='V26PUR-'+Utilities.getUuid();sh.appendRow([id,r.data.planId,r.data.weekFrom,x.product,x.unit,x.shortage,_mcV25Date_(x.due),'OPEN',now,actor]);created.push({requestId:id,product:x.product,qty:x.shortage,unit:x.unit,needBy:x.due});});return _ok_({planId:r.data.planId,created:created,count:created.length});}catch(e){return _failFrom_(e);}}
function getV26PurchaseRequests(fromDate,token){try{_requireAuth_(token,'stock');var r0=buildV26Dispatch(fromDate,token),r=_mcV22Parse_(r0);if(!(r.ok||r.success))return r0;var sh=_mcV26Purchase_(),v=sh.getDataRange().getValues(),out=[];for(var i=1;i<v.length;i++)if(String(v[i][1])===String(r.data.planId))out.push({requestId:v[i][0],product:v[i][3],unit:v[i][4],qty:Number(v[i][5])||0,needBy:v[i][6],status:v[i][7]});return _ok_({planId:r.data.planId,rows:out});}catch(e){return _failFrom_(e);}}

function getV26Dispatch(fromDate,token){try{_requireAuth_(token,'kanban');var sh=_mcV26Plan_(),v=sh.getDataRange().getValues(),from=_mcV25Date_(_mcV14Monday_(new Date(fromDate||new Date()))),out=[];for(var i=1;i<v.length;i++)if(String(v[i][2])===from)out.push({dispatchId:v[i][0],product:v[i][6],unit:v[i][7],needQty:Number(v[i][8])||0,fefoQty:Number(v[i][9])||0,shortage:Number(v[i][10])||0,earliestBatch:v[i][11],location:v[i][12],reserveStatus:v[i][13],purchaseStatus:v[i][14]});return _ok_({weekFrom:from,rows:out});}catch(e){return _failFrom_(e);}}
