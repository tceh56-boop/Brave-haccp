{
  // Демо-стенд ЦЕХ в GitHub Codespaces: «Code» → «Codespaces» → «Create codespace».
  // Через 3–5 минут откроется система с демо-организацией: vladelec@demo.test / Демо-ЦЕХ-2026.
  "name": "ЦЕХ — демо-стенд",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "forwardPorts": [3000, "mail:8025"],
  "portsAttributes": {
    "3000": { "label": "ЦЕХ", "onAutoForward": "openBrowser" },
    "mail:8025": { "label": "Почта (Mailpit)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash platform/deploy/codespace.sh setup",
  "postStartCommand": "bash platform/deploy/codespace.sh start",
  "customizations": { "codespaces": { "openFiles": ["platform/README.md"] } }
}
